// Sweep Closure Sequencer [SCS-MTF]
//@version=6
indicator("Sweep Closure Sequencer MTF [SCS-MTF]", "SCS-MTF", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// =====================================================================
// Inputs
// =====================================================================
g_tf   = "Timeframe"
g_bias = "Bias"
g_lc2  = "Closure Line - C2 (depth 1)"
g_lc3  = "Closure Line - C3 (depth 2)"
g_box  = "Equilibrium Box (LTF only)"
g_open = "HTF Opening Line (LTF only)"
g_kl   = "Key Levels in Equilibrium (LTF only)"
g_disp = "Display"

htfStr  = input.timeframe("240", "HTF (reversal source)", group = g_tf, tooltip = "Aligned LTF: 15-1, 30-3, 60-5, 240-15, 1D-60, 1W-240")
biasStr = input.string("Auto", "Bias", options = ["Auto", "Bullish only", "Bearish only"], group = g_bias)

// C2 closure
showLine1     = input.bool(true,                  "Show closure line",                   group = g_lc2)
line1Color    = input.color(color.new(#ff1744, 0),"Color",                                group = g_lc2)
line1Width    = input.int(2, "Width", minval = 1, maxval = 5,                             group = g_lc2)
line1Extra    = input.int(1, "Extension (HTF bars)", minval = 0, maxval = 10,             group = g_lc2)
line1StyleStr = input.string("Solid", "Style", options = ["Solid","Dashed","Dotted"],     group = g_lc2)
line1OnLtf    = input.bool(true, "Also render on aligned LTF chart",                      group = g_lc2)

// C3 closure
showLine2     = input.bool(true,                  "Show closure line",                   group = g_lc3)
line2Color    = input.color(color.new(#ff9100, 0),"Color",                                group = g_lc3)
line2Width    = input.int(2, "Width", minval = 1, maxval = 5,                             group = g_lc3)
line2Extra    = input.int(1, "Extension (HTF bars)", minval = 0, maxval = 10,             group = g_lc3)
line2StyleStr = input.string("Solid", "Style", options = ["Solid","Dashed","Dotted"],     group = g_lc3)
line2OnLtf    = input.bool(true, "Also render on aligned LTF chart",                      group = g_lc3)

// Equilibrium box
showBox       = input.bool(true,                  "Show equilibrium box",                 group = g_box)
boxBullColor  = input.color(color.new(#2196f3, 80),"Bull box fill",                       group = g_box)
boxBearColor  = input.color(color.new(#2196f3, 80),"Bear box fill",                       group = g_box)
boxBullBorder = input.color(color.new(#2196f3, 50),"Bull box border",                     group = g_box)
boxBearBorder = input.color(color.new(#2196f3, 50),"Bear box border",                     group = g_box)
boxBorderW    = input.int(1, "Border width", minval = 0, maxval = 3,                      group = g_box)
boxExtraHtf   = input.int(1, "Extension (HTF bars)", minval = 1, maxval = 10,             group = g_box)

// HTF opening line (vertical)
showOpen      = input.bool(true,                  "Show HTF opening line",                group = g_open)
openColor     = input.color(color.new(#ffcc00, 40),"Color",                               group = g_open)
openWidth     = input.int(1, "Width", minval = 1, maxval = 5,                             group = g_open)
openStyleStr  = input.string("Dotted", "Style", options = ["Solid","Dashed","Dotted"],    group = g_open)
openExtendStr = input.string("Both", "Extend", options = ["Both","Up","Down","None"],     group = g_open)
openHistory   = input.bool(true, "Keep historical opens",                                 group = g_open)

// Key levels (canonical detection from [Astrophile] - Key Levels)
showSwingH      = input.bool(true,  "Show Swing High",                                    group = g_kl)
showSwingL      = input.bool(true,  "Show Swing Low",                                     group = g_kl)
showBullFVG     = input.bool(true,  "Show Bullish FVG",                                   group = g_kl)
showBearFVG     = input.bool(true,  "Show Bearish FVG",                                   group = g_kl)
swingStrength   = input.int(2, "Swing Strength", minval = 1, maxval = 10,                 group = g_kl)
hideMitigated   = input.bool(true,  "Hide Mitigated Levels",                              group = g_kl)
swingHColor     = input.color(color.new(#ff1744, 0),  "Swing High Color",                 group = g_kl)
swingLColor     = input.color(color.new(#00e676, 0),  "Swing Low Color",                  group = g_kl)
swingWidth      = input.int(1, "Swing Line Width", minval = 1, maxval = 3,                group = g_kl)
swingStyleStr   = input.string("Solid", "Swing Style", options = ["Solid","Dashed","Dotted"], group = g_kl)
bullFVGColor    = input.color(color.new(#00e676, 80), "Bull FVG Fill",                    group = g_kl)
bullFVGBorder   = input.color(color.new(#00e676, 50), "Bull FVG Border",                  group = g_kl)
bearFVGColor    = input.color(color.new(#ff1744, 80), "Bear FVG Fill",                    group = g_kl)
bearFVGBorder   = input.color(color.new(#ff1744, 50), "Bear FVG Border",                  group = g_kl)
fvgBorderWidth  = input.int(1, "FVG Border Width", minval = 0, maxval = 3,                group = g_kl)

// Display
displayDays = input.int(7, "Last N days", minval = 1, maxval = 60, group = g_disp)

// =====================================================================
// Helpers
// =====================================================================
lineStyleFn(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

verticalExtendFn(string e) =>
    e == "Both" ? extend.both : e == "Up" ? extend.right : e == "Down" ? extend.left : extend.none

// =====================================================================
// Context / aligned timeframe
// =====================================================================
alignedLtf = htfStr == "15"  ? "1"   : htfStr == "30"  ? "3"   : htfStr == "60"  ? "5"   : htfStr == "240" ? "15"  : htfStr == "1D"  ? "60"  : htfStr == "1W"  ? "240" : ""

chartTf    = timeframe.period
isHtfChart = chartTf == htfStr
isLtfChart = (alignedLtf != "") and (chartTf == alignedLtf)
hasContext = isHtfChart or isLtfChart

htfSec     = timeframe.in_seconds(htfStr)
chartSec   = timeframe.in_seconds()
barsPerHtf = chartSec > 0 ? math.max(1, math.round(htfSec / chartSec)) : 1

displayBars = math.round(displayDays * 86400 / math.max(60, chartSec))
inDisplay   = bar_index >= (last_bar_index - displayBars)

allowBull = biasStr == "Auto" or biasStr == "Bullish only"
allowBear = biasStr == "Auto" or biasStr == "Bearish only"

// =====================================================================
// HTF data
// =====================================================================
[htfH1, htfL1, htfC1, htfH2, htfL2, htfC2, htfH3, htfL3] = request.security(syminfo.tickerid, htfStr, [high[1], low[1], close[1], high[2], low[2], close[2], high[3], low[3]], lookahead = barmerge.lookahead_on)

htfStartT   = time(htfStr)
isNewHtfBar = ta.change(htfStartT) != 0

var float currentHtfOpen = na
if isNewHtfBar
    currentHtfOpen := open

// =====================================================================
// Reversal detection
// =====================================================================
canEval = isNewHtfBar and not na(htfL2) and not na(htfH2) and not na(htfC1)

revBull1 = canEval and allowBull and htfL1 < htfL2 and htfC1 > htfL2
revBear1 = canEval and allowBear and htfH1 > htfH2 and htfC1 < htfH2

canEval2   = canEval and not na(htfL3) and not na(htfH3) and not na(htfC2)
c2BullCont = canEval2 and htfL2 < htfL3 and htfC2 < htfL3
c2BearCont = canEval2 and htfH2 > htfH3 and htfC2 > htfH3

revBull2 = canEval2 and allowBull and htfL1 < htfL3 and htfC1 > htfL3 and c2BullCont
revBear2 = canEval2 and allowBear and htfH1 > htfH3 and htfC1 < htfH3 and c2BearCont

bullFire = revBull1 or revBull2
bearFire = revBear1 or revBear2

// =====================================================================
// Closure lines
// =====================================================================
canRender1 = hasContext and (isHtfChart or (isLtfChart and line1OnLtf))
canRender2 = hasContext and (isHtfChart or (isLtfChart and line2OnLtf))

if showLine1 and canRender1 and inDisplay
    if revBull1
        line.new(bar_index - barsPerHtf * 2, htfL2, bar_index + barsPerHtf * line1Extra, htfL2, color = line1Color, width = line1Width, style = lineStyleFn(line1StyleStr), xloc = xloc.bar_index)
    if revBear1
        line.new(bar_index - barsPerHtf * 2, htfH2, bar_index + barsPerHtf * line1Extra, htfH2, color = line1Color, width = line1Width, style = lineStyleFn(line1StyleStr), xloc = xloc.bar_index)

if showLine2 and canRender2 and inDisplay
    if revBull2
        line.new(bar_index - barsPerHtf * 3, htfL3, bar_index + barsPerHtf * line2Extra, htfL3, color = line2Color, width = line2Width, style = lineStyleFn(line2StyleStr), xloc = xloc.bar_index)
    if revBear2
        line.new(bar_index - barsPerHtf * 3, htfH3, bar_index + barsPerHtf * line2Extra, htfH3, color = line2Color, width = line2Width, style = lineStyleFn(line2StyleStr), xloc = xloc.bar_index)

// =====================================================================
// KEY LEVELS (canonical detection from [Astrophile] - Key Levels)
// Track on LTF chart bars; mitigation via close-through rule.
// =====================================================================
var float[] swingHs       = array.new_float(0)
var int[]   swingHBars    = array.new_int(0)
var bool[]  swingHMit     = array.new_bool(0)

var float[] swingLs       = array.new_float(0)
var int[]   swingLBars    = array.new_int(0)
var bool[]  swingLMit     = array.new_bool(0)

var float[] bullFVGTops   = array.new_float(0)
var float[] bullFVGBots   = array.new_float(0)
var int[]   bullFVGBars   = array.new_int(0)
var bool[]  bullFVGMit    = array.new_bool(0)

var float[] bearFVGTops   = array.new_float(0)
var float[] bearFVGBots   = array.new_float(0)
var int[]   bearFVGBars   = array.new_int(0)
var bool[]  bearFVGMit    = array.new_bool(0)

if isLtfChart
    // ── swing detection ──
    swH = ta.pivothigh(high, swingStrength, swingStrength)
    swL = ta.pivotlow(low,  swingStrength, swingStrength)

    if not na(swH)
        array.push(swingHs, swH)
        array.push(swingHBars, bar_index - swingStrength)
        array.push(swingHMit, false)
        if array.size(swingHs) > 50
            array.shift(swingHs)
            array.shift(swingHBars)
            array.shift(swingHMit)

    if not na(swL)
        array.push(swingLs, swL)
        array.push(swingLBars, bar_index - swingStrength)
        array.push(swingLMit, false)
        if array.size(swingLs) > 50
            array.shift(swingLs)
            array.shift(swingLBars)
            array.shift(swingLMit)

    // ── FVG detection (3-candle) ──
    bullFVG = low > high[2]
    bearFVG = high < low[2]

    if bullFVG
        array.push(bullFVGTops, low)
        array.push(bullFVGBots, high[2])
        array.push(bullFVGBars, bar_index - 1)
        array.push(bullFVGMit,  false)
        if array.size(bullFVGTops) > 50
            array.shift(bullFVGTops)
            array.shift(bullFVGBots)
            array.shift(bullFVGBars)
            array.shift(bullFVGMit)

    if bearFVG
        array.push(bearFVGTops, low[2])
        array.push(bearFVGBots, high)
        array.push(bearFVGBars, bar_index - 1)
        array.push(bearFVGMit,  false)
        if array.size(bearFVGTops) > 50
            array.shift(bearFVGTops)
            array.shift(bearFVGBots)
            array.shift(bearFVGBars)
            array.shift(bearFVGMit)

    // ── mitigation (close-through) ──
    if hideMitigated
        if array.size(swingHs) > 0
            for i = 0 to array.size(swingHs) - 1
                if not array.get(swingHMit, i) and close > array.get(swingHs, i)
                    array.set(swingHMit, i, true)
        if array.size(swingLs) > 0
            for i = 0 to array.size(swingLs) - 1
                if not array.get(swingLMit, i) and close < array.get(swingLs, i)
                    array.set(swingLMit, i, true)
        if array.size(bullFVGTops) > 0
            for i = 0 to array.size(bullFVGTops) - 1
                if not array.get(bullFVGMit, i) and close < array.get(bullFVGBots, i)
                    array.set(bullFVGMit, i, true)
        if array.size(bearFVGTops) > 0
            for i = 0 to array.size(bearFVGTops) - 1
                if not array.get(bearFVGMit, i) and close > array.get(bearFVGTops, i)
                    array.set(bearFVGMit, i, true)

// =====================================================================
// Equilibrium box + key levels overlapping eq area  (LTF only)
// =====================================================================
canBox = isLtfChart and showBox

if canBox and inDisplay and not na(currentHtfOpen) and (bullFire or bearFire)
    eqMid       = bullFire ? (currentHtfOpen + htfL1) / 2.0 : (currentHtfOpen + htfH1) / 2.0
    boxLeft     = bar_index
    boxRight    = bar_index + barsPerHtf * boxExtraHtf
    boxTopPrice = bullFire ? currentHtfOpen : eqMid
    boxBotPrice = bullFire ? eqMid : currentHtfOpen

    if bullFire
        box.new(boxLeft, currentHtfOpen, boxRight, eqMid, bgcolor = boxBullColor, border_color = boxBullBorder, border_width = boxBorderW, xloc = xloc.bar_index)
    if bearFire
        box.new(boxLeft, eqMid, boxRight, currentHtfOpen, bgcolor = boxBearColor, border_color = boxBearBorder, border_width = boxBorderW, xloc = xloc.bar_index)

    // swing highs whose price sits in the eq area
    if showSwingH and array.size(swingHs) > 0
        for i = 0 to array.size(swingHs) - 1
            mit = hideMitigated and array.get(swingHMit, i)
            p   = array.get(swingHs, i)
            b   = array.get(swingHBars, i)
            if not mit and p >= boxBotPrice and p <= boxTopPrice
                line.new(b, p, boxRight, p, color = swingHColor, width = swingWidth, style = lineStyleFn(swingStyleStr), xloc = xloc.bar_index)

    // swing lows
    if showSwingL and array.size(swingLs) > 0
        for i = 0 to array.size(swingLs) - 1
            mit = hideMitigated and array.get(swingLMit, i)
            p   = array.get(swingLs, i)
            b   = array.get(swingLBars, i)
            if not mit and p >= boxBotPrice and p <= boxTopPrice
                line.new(b, p, boxRight, p, color = swingLColor, width = swingWidth, style = lineStyleFn(swingStyleStr), xloc = xloc.bar_index)

    // bullish FVGs that overlap eq area
    if showBullFVG and array.size(bullFVGTops) > 0
        for i = 0 to array.size(bullFVGTops) - 1
            mit = hideMitigated and array.get(bullFVGMit, i)
            t   = array.get(bullFVGTops, i)
            bt  = array.get(bullFVGBots, i)
            xb  = array.get(bullFVGBars, i)
            overlap = not (t < boxBotPrice or bt > boxTopPrice)
            if not mit and overlap
                box.new(xb, t, boxRight, bt, bgcolor = bullFVGColor, border_color = bullFVGBorder, border_width = fvgBorderWidth, xloc = xloc.bar_index)

    // bearish FVGs
    if showBearFVG and array.size(bearFVGTops) > 0
        for i = 0 to array.size(bearFVGTops) - 1
            mit = hideMitigated and array.get(bearFVGMit, i)
            t   = array.get(bearFVGTops, i)
            bt  = array.get(bearFVGBots, i)
            xb  = array.get(bearFVGBars, i)
            overlap = not (t < boxBotPrice or bt > boxTopPrice)
            if not mit and overlap
                box.new(xb, t, boxRight, bt, bgcolor = bearFVGColor, border_color = bearFVGBorder, border_width = fvgBorderWidth, xloc = xloc.bar_index)

// =====================================================================
// HTF opening line (LTF only, VERTICAL line)
// =====================================================================
canOpen = isLtfChart and showOpen
var line htfOpenLn = na

if canOpen and isNewHtfBar
    if not openHistory and not na(htfOpenLn)
        line.delete(htfOpenLn)
    htfOpenLn := line.new(bar_index, low, bar_index, high, color = openColor, width = openWidth, style = lineStyleFn(openStyleStr), extend = verticalExtendFn(openExtendStr), xloc = xloc.bar_index)
