// Sweep Closure Sequencer [SCS]
// =============================
// Visual style modeled after Fractal Candle Closure
// (feat/smt-quarter-sequences branch).
//
// Logic - immediate C1/C2 detection (no rolling state machine):
//   Bullish reversal: low < low[1] and close > low[1]
//   Bearish reversal: high > high[1] and close < high[1]
//
// Drawings:
//   - Closure line at the swept extreme on the C2 bar
//   - Equilibrium box on the next (C3) bar, from C3.open to the midpoint
//     of [open(C3), low(C2)] (bullish) or [open(C3), high(C2)] (bearish)
//
// No labels, no text. Only lines and boxes.

//@version=6
indicator("Sweep Closure Sequencer [SCS]", "SCS", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// =====================================================================
// Display
// =====================================================================
g_disp = "Display"
displayDays = input.int(3, "Show Last N Days", minval = 1, maxval = 30, group = g_disp)

// =====================================================================
// Closure line
// =====================================================================
g_line       = "Closure Line"
showLine     = input.bool(true, "Show Closure Line",                                     group = g_line)
lineColor    = input.color(color.new(#ff1744, 0), "Line Color",                          group = g_line)
lineWidth    = input.int(1, "Line Width", minval = 1, maxval = 5,                        group = g_line)
lineStyleStr = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = g_line)
lineExtra    = input.int(1, "Line Extra Bars", minval = 0, maxval = 10,                  group = g_line)

// =====================================================================
// Equilibrium box
// =====================================================================
g_eq         = "Equilibrium Box"
showEq       = input.bool(true, "Show Equilibrium Box",                                  group = g_eq)
eqBullColor  = input.color(color.new(#2196f3, 80), "Bull Box Color",                     group = g_eq)
eqBearColor  = input.color(color.new(#2196f3, 80), "Bear Box Color",                     group = g_eq)
eqBullBorder = input.color(color.new(#2196f3, 50), "Bull Border",                        group = g_eq)
eqBearBorder = input.color(color.new(#2196f3, 50), "Bear Border",                        group = g_eq)
eqBorderW    = input.int(1, "Border Width", minval = 0, maxval = 3,                      group = g_eq)
eqExtra      = input.int(2, "Box Extra Bars", minval = 0, maxval = 20,                   group = g_eq)

// =====================================================================
// Helpers
// =====================================================================
lineStyleFn(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// =====================================================================
// Display window (last N days only)
// =====================================================================
barsPerDay  = timeframe.in_seconds() > 0 ? math.round(86400 / timeframe.in_seconds()) : 24
displayBars = displayDays * barsPerDay
inDisplay   = bar_index >= (last_bar_index - displayBars)

// =====================================================================
// C2 reversal detection (immediate, just like fractal_candle_closure.pine)
// =====================================================================
bool revBull = (low  < low[1])  and (close > low[1])    // bullish reversal: swept C1 low, closed back above
bool revBear = (high > high[1]) and (close < high[1])   // bearish reversal: swept C1 high, closed back below

bool prevRevBull = revBull[1]
bool prevRevBear = revBear[1]

// =====================================================================
// Equilibrium midpoints
//   bullish: range [low[1], open]   midpoint = low[1] + (open - low[1])/2
//   bearish: range [open, high[1]]  midpoint = high[1] - (high[1] - open)/2
// =====================================================================
float bullEq = low[1]  + (open - low[1])  / 2.0
float bearEq = high[1] - (high[1] - open) / 2.0

// =====================================================================
// Draw closure line on the C2 bar
// =====================================================================
if showLine and revBull and inDisplay
    line.new(bar_index - 1, low[1], bar_index + lineExtra, low[1], color = lineColor, width = lineWidth, style = lineStyleFn(lineStyleStr))

if showLine and revBear and inDisplay
    line.new(bar_index - 1, high[1], bar_index + lineExtra, high[1], color = lineColor, width = lineWidth, style = lineStyleFn(lineStyleStr))

// =====================================================================
// Draw equilibrium box on the C3 bar (one bar after C2)
// =====================================================================
if showEq and prevRevBull and inDisplay
    box.new(bar_index, open, bar_index + eqExtra, bullEq, bgcolor = eqBullColor, border_color = eqBullBorder, border_width = eqBorderW)

if showEq and prevRevBear and inDisplay
    box.new(bar_index, bearEq, bar_index + eqExtra, open, bgcolor = eqBearColor, border_color = eqBearBorder, border_width = eqBorderW)
