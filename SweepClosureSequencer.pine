// Sweep Closure Sequencer [SCS-MTF] + CISD-gated visuals
//
// Aligned chart map (HTF -> Primary LTF + Middle TF):
//   1D  -> 1H  + 4H
//   4H  -> 15m + 1H
//   1H  -> 5m  + 15m
//   30m -> 3m  + 15m
//   15m -> 1m  + 5m
//
// Strict validity rules:
//   - HTF C2/C3 reversal is "valid" ONLY if CISD confirms in the
//     continuation HTF candle on the aligned chart (LTF or Middle TF).
//   - If CISD does not confirm by the end of that continuation candle,
//     NOTHING is drawn for that setup.
//
// What renders, only when CISD confirms:
//   - C2 / C3 closure line at the swept extreme (configurable colors)
//   - Equilibrium box from open(continuation HTF) to midpoint
//   - CISD anchor line (open of OLDEST candle in the consecutive run)
//   - Run bracket above/below the consecutive run
//
// HTF opening line (vertical) is independent and renders on the LTF chart
// regardless of CISD outcome.

//@version=6
indicator("Sweep Closure Sequencer MTF [SCS-MTF]", "SCS-MTF", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// =====================================================================
// Inputs
// =====================================================================
g_tf   = "Timeframe"
g_bias = "Bias"
g_lc2  = "Closure Line - C2 (depth 1)"
g_lc3  = "Closure Line - C3 (depth 2)"
g_box  = "Equilibrium Box"
g_open = "HTF Opening Line"
g_cisd = "CISD"
g_disp = "Display"

htfStr  = input.timeframe("240", "HTF (reversal source)", group = g_tf, tooltip = "Aligned LTF + Middle TF: 1D→1H+4H, 240→15+60, 60→5+15, 30→3+15, 15→1+5")
biasStr = input.string("Auto", "Bias", options = ["Auto", "Bullish only", "Bearish only"], group = g_bias)

// C2 closure
showLine1     = input.bool(true,                  "Show closure line",                   group = g_lc2)
line1Color    = input.color(color.new(#ff1744, 0),"Color",                                group = g_lc2)
line1Width    = input.int(2, "Width", minval = 1, maxval = 5,                             group = g_lc2)
line1Extra    = input.int(1, "Extension (HTF bars)", minval = 0, maxval = 10,             group = g_lc2)
line1StyleStr = input.string("Solid", "Style", options = ["Solid","Dashed","Dotted"],     group = g_lc2)

// C3 closure
showLine2     = input.bool(true,                  "Show closure line",                   group = g_lc3)
line2Color    = input.color(color.new(#ff9100, 0),"Color",                                group = g_lc3)
line2Width    = input.int(2, "Width", minval = 1, maxval = 5,                             group = g_lc3)
line2Extra    = input.int(1, "Extension (HTF bars)", minval = 0, maxval = 10,             group = g_lc3)
line2StyleStr = input.string("Solid", "Style", options = ["Solid","Dashed","Dotted"],     group = g_lc3)

// Equilibrium box
showBox       = input.bool(true,                  "Show equilibrium box",                 group = g_box)
boxBullColor  = input.color(color.new(#2196f3, 80),"Bull box fill",                       group = g_box)
boxBearColor  = input.color(color.new(#2196f3, 80),"Bear box fill",                       group = g_box)
boxBullBorder = input.color(color.new(#2196f3, 50),"Bull box border",                     group = g_box)
boxBearBorder = input.color(color.new(#2196f3, 50),"Bear box border",                     group = g_box)
boxBorderW    = input.int(1, "Border width", minval = 0, maxval = 3,                      group = g_box)
boxExtraHtf   = input.int(1, "Extension (HTF bars)", minval = 1, maxval = 10,             group = g_box)

// HTF opening line (vertical, LTF only)
showOpen      = input.bool(true,                  "Show HTF opening line",                group = g_open)
openColor     = input.color(color.new(#ffcc00, 40),"Color",                               group = g_open)
openWidth     = input.int(1, "Width", minval = 1, maxval = 5,                             group = g_open)
openStyleStr  = input.string("Dotted", "Style", options = ["Solid","Dashed","Dotted"],    group = g_open)
openExtendStr = input.string("Both", "Extend", options = ["Both","Up","Down","None"],     group = g_open)
openHistory   = input.bool(true, "Keep historical opens",                                 group = g_open)

// CISD visuals
cisdAnchorColor  = input.color(color.new(#2563eb, 0), "Anchor line color",        group = g_cisd)
cisdAnchorWidth  = input.int(2, "Anchor line width", minval = 1, maxval = 4,      group = g_cisd)
cisdAnchorStyle  = input.string("Dashed", "Anchor line style", options = ["Solid","Dashed","Dotted"], group = g_cisd)
cisdShowBracket  = input.bool(true,                  "Show consecutive run bracket", group = g_cisd)
cisdBracketColor = input.color(color.new(#7c3aed, 0), "Run bracket color",        group = g_cisd)

// Display
displayDays = input.int(7, "Last N days", minval = 1, maxval = 60, group = g_disp)

// =====================================================================
// Helpers
// =====================================================================
lineStyleFn(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

verticalExtendFn(string e) =>
    e == "Both" ? extend.both : e == "Up" ? extend.right : e == "Down" ? extend.left : extend.none

// =====================================================================
// Aligned timeframe map (Primary LTF + Middle TF)
// =====================================================================
alignedLtf   = htfStr == "15" ? "1"  : htfStr == "30" ? "3"  : htfStr == "60" ? "5"  : htfStr == "240" ? "15" : htfStr == "1D" ? "60"  : ""
alignedMidTf = htfStr == "15" ? "5"  : htfStr == "30" ? "15" : htfStr == "60" ? "15" : htfStr == "240" ? "60" : htfStr == "1D" ? "240" : ""

chartTf    = timeframe.period
isLtfChart = (alignedLtf   != "") and (chartTf == alignedLtf)
isMidChart = (alignedMidTf != "") and (chartTf == alignedMidTf)
isAligned  = isLtfChart or isMidChart

htfSec     = timeframe.in_seconds(htfStr)
chartSec   = timeframe.in_seconds()
barsPerHtf = chartSec > 0 ? math.max(1, math.round(htfSec / chartSec)) : 1

displayBars = math.round(displayDays * 86400 / math.max(60, chartSec))
inDisplay   = bar_index >= (last_bar_index - displayBars)

allowBull = biasStr == "Auto" or biasStr == "Bullish only"
allowBear = biasStr == "Auto" or biasStr == "Bearish only"

// =====================================================================
// HTF data
// =====================================================================
[htfH1, htfL1, htfC1, htfH2, htfL2, htfC2, htfH3, htfL3] = request.security(syminfo.tickerid, htfStr, [high[1], low[1], close[1], high[2], low[2], close[2], high[3], low[3]], lookahead = barmerge.lookahead_on)

htfStartT   = time(htfStr)
isNewHtfBar = ta.change(htfStartT) != 0

var float currentHtfOpen = na
if isNewHtfBar
    currentHtfOpen := open

// =====================================================================
// Reversal detection (HTF series)
// =====================================================================
canEval = isNewHtfBar and not na(htfL2) and not na(htfH2) and not na(htfC1)

revBull1 = canEval and allowBull and htfL1 < htfL2 and htfC1 > htfL2
revBear1 = canEval and allowBear and htfH1 > htfH2 and htfC1 < htfH2

canEval2   = canEval and not na(htfL3) and not na(htfH3) and not na(htfC2)
c2BullCont = canEval2 and htfL2 < htfL3 and htfC2 < htfL3
c2BearCont = canEval2 and htfH2 > htfH3 and htfC2 > htfH3

revBull2 = canEval2 and allowBull and htfL1 < htfL3 and htfC1 > htfL3 and c2BullCont
revBear2 = canEval2 and allowBear and htfH1 > htfH3 and htfC1 < htfH3 and c2BearCont

bullFire = revBull1 or revBull2
bearFire = revBear1 or revBear2

// =====================================================================
// HTF opening line (LTF only — independent of CISD)
// =====================================================================
canOpen = isLtfChart and showOpen
var line htfOpenLn = na

if canOpen and isNewHtfBar
    if not openHistory and not na(htfOpenLn)
        line.delete(htfOpenLn)
    htfOpenLn := line.new(bar_index, low, bar_index, high, color = openColor, width = openWidth, style = lineStyleFn(openStyleStr), extend = verticalExtendFn(openExtendStr), xloc = xloc.bar_index)

// =====================================================================
// CISD detection helpers (run on whatever aligned chart we are on)
// =====================================================================

findBullCisd() =>
    int   winSearch = barsPerHtf * 4
    int   lowBar    = bar_index - 1
    float lowVal    = low[1]
    if barsPerHtf > 1
        for i = 1 to barsPerHtf - 1
            v = low[i + 1]
            if not na(v) and v < lowVal
                lowVal := v
                lowBar := bar_index - i - 1
    int   iter   = lowBar
    int   newRun = na
    int   oldRun = na
    float anch   = na
    int   guard  = 0
    while iter >= bar_index - winSearch and guard < 300
        int off = bar_index - iter
        if off >= 0 and close[off] < open[off]
            newRun := iter
            break
        iter -= 1
        guard += 1
    if not na(newRun)
        oldRun := newRun
        int j = newRun - 1
        int g2 = 0
        while j >= bar_index - winSearch and g2 < 300
            int off = bar_index - j
            if off >= 0 and close[off] < open[off]
                oldRun := j
                j -= 1
                g2 += 1
            else
                break
        anch := open[bar_index - oldRun]
    [anch, oldRun, newRun]

findBearCisd() =>
    int   winSearch = barsPerHtf * 4
    int   hiBar     = bar_index - 1
    float hiVal     = high[1]
    if barsPerHtf > 1
        for i = 1 to barsPerHtf - 1
            v = high[i + 1]
            if not na(v) and v > hiVal
                hiVal := v
                hiBar := bar_index - i - 1
    int   iter   = hiBar
    int   newRun = na
    int   oldRun = na
    float anch   = na
    int   guard  = 0
    while iter >= bar_index - winSearch and guard < 300
        int off = bar_index - iter
        if off >= 0 and close[off] > open[off]
            newRun := iter
            break
        iter -= 1
        guard += 1
    if not na(newRun)
        oldRun := newRun
        int j = newRun - 1
        int g2 = 0
        while j >= bar_index - winSearch and g2 < 300
            int off = bar_index - j
            if off >= 0 and close[off] > open[off]
                oldRun := j
                j -= 1
                g2 += 1
            else
                break
        anch := open[bar_index - oldRun]
    [anch, oldRun, newRun]

// =====================================================================
// Pending CISD state (per aligned chart)
// =====================================================================
var int    pendDir       = 0
var float  pendAnchor    = na
var int    pendOldBar    = na
var int    pendNewBar    = na
var int    pendStart     = na
var int    pendDepth     = 0
var float  pendCloseLvl  = na
var int    pendCloseLeft = na
var float  pendBoxOpen   = na
var float  pendBoxExt    = na

// On HTF reversal: arm pending state, draw nothing yet
if isAligned and inDisplay and (bullFire or bearFire)
    float a    = na
    int   oldR = na
    int   newR = na
    if bullFire
        [aa, oo, nn] = findBullCisd()
        a    := aa
        oldR := oo
        newR := nn
    else
        [aa, oo, nn] = findBearCisd()
        a    := aa
        oldR := oo
        newR := nn

    if not na(a) and not na(oldR) and not na(newR)
        pendDir       := bullFire ? 1 : -1
        pendAnchor    := a
        pendOldBar    := oldR
        pendNewBar    := newR
        pendStart     := bar_index
        pendDepth     := (revBull2 or revBear2) ? 2 : 1
        pendBoxOpen   := currentHtfOpen
        pendBoxExt    := bullFire ? htfL1 : htfH1
        pendCloseLvl  := pendDepth == 2 ? (bullFire ? htfL3 : htfH3) : (bullFire ? htfL2 : htfH2)
        pendCloseLeft := pendDepth == 2 ? bar_index - barsPerHtf * 3 : bar_index - barsPerHtf * 2

// Watch for CISD trigger inside the continuation HTF candle
if isAligned and pendDir != 0 and not na(pendAnchor) and barstate.isconfirmed and bar_index > pendStart
    bool expired = bar_index - pendStart >= barsPerHtf
    bool fired   = (pendDir == 1 and close > pendAnchor) or (pendDir == -1 and close < pendAnchor)

    if fired
        bool isDepth2 = pendDepth == 2

        // ─── Closure line ───
        if (isDepth2 and showLine2) or (not isDepth2 and showLine1)
            color  cCol = isDepth2 ? line2Color    : line1Color
            int    cW   = isDepth2 ? line2Width    : line1Width
            string cSt  = isDepth2 ? line2StyleStr : line1StyleStr
            int    cEx  = isDepth2 ? line2Extra    : line1Extra
            line.new(pendCloseLeft, pendCloseLvl, bar_index + barsPerHtf * cEx, pendCloseLvl, color = cCol, width = cW, style = lineStyleFn(cSt), xloc = xloc.bar_index)

        // ─── Equilibrium box ───
        if showBox and not na(pendBoxOpen) and not na(pendBoxExt)
            float eqMid = (pendBoxOpen + pendBoxExt) / 2.0
            int   boxR  = bar_index + barsPerHtf * boxExtraHtf
            if pendDir == 1
                box.new(bar_index, pendBoxOpen, boxR, eqMid, bgcolor = boxBullColor, border_color = boxBullBorder, border_width = boxBorderW, xloc = xloc.bar_index)
            else
                box.new(bar_index, eqMid, boxR, pendBoxOpen, bgcolor = boxBearColor, border_color = boxBearBorder, border_width = boxBorderW, xloc = xloc.bar_index)

        // ─── CISD anchor line ───
        line.new(pendOldBar, pendAnchor, bar_index, pendAnchor, color = cisdAnchorColor, width = cisdAnchorWidth, style = lineStyleFn(cisdAnchorStyle), xloc = xloc.bar_index)

        // ─── Consecutive run bracket ───
        if cisdShowBracket
            float span     = math.abs(high[bar_index - pendOldBar] - low[bar_index - pendOldBar])
            float yBracket = pendDir == 1 ? open[bar_index - pendOldBar] + span * 0.4 : open[bar_index - pendOldBar] - span * 0.4
            float yTick    = pendDir == 1 ? yBracket - span * 0.15 : yBracket + span * 0.15
            line.new(pendOldBar, yBracket, pendNewBar, yBracket, color = cisdBracketColor, width = 2, xloc = xloc.bar_index)
            line.new(pendOldBar, yBracket, pendOldBar, yTick,    color = cisdBracketColor, width = 2, xloc = xloc.bar_index)
            line.new(pendNewBar, yBracket, pendNewBar, yTick,    color = cisdBracketColor, width = 2, xloc = xloc.bar_index)

        pendDir    := 0
        pendAnchor := na

    if not fired and expired
        // CISD failed inside the continuation candle — discard, no visuals
        pendDir    := 0
        pendAnchor := na
