// Sweep Closure Sequencer [SCS-MTF] + CISD-gated visuals
//
// Aligned chart map (HTF -> Primary LTF + Middle TF):
//   1D  -> 1H  + 4H
//   4H  -> 15m + 1H
//   1H  -> 5m  + 15m
//   30m -> 3m  + 15m
//   15m -> 1m  + 5m
//
// Strict validity rules:
//   - C2 reversal (depth-1) is valid ONLY if CISD confirms INSIDE the
//     continuation HTF candle (the C3 candle in user terminology) on
//     the aligned chart (LTF or Middle TF).
//   - C3 reversal (depth-2) is valid ONLY if CISD confirms INSIDE the
//     continuation HTF candle (the C4 candle in user terminology).
//   - Both are tracked INDEPENDENTLY. Each draws its own visuals only
//     when its own CISD confirms.
//   - If CISD does not confirm by the end of the continuation candle,
//     NOTHING is drawn for that setup.
//
// CISD search is dynamic and STRICTLY contained within the continuation
// HTF candle's LTF bars.

//@version=6
indicator("Sweep Closure Sequencer MTF [SCS-MTF]", "SCS-MTF", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// =====================================================================
// Inputs
// =====================================================================
g_tf   = "Timeframe"
g_bias = "Bias"
g_lc2  = "C2 Reversal (depth 1)"
g_lc3  = "C3 Reversal (depth 2)"
g_box  = "Equilibrium Box"
g_open = "HTF Opening Line"
g_cisd = "CISD"
g_disp = "Display"

htfStr  = input.timeframe("240", "HTF (reversal source)", group = g_tf, tooltip = "Aligned LTF + Middle TF: 1D→1H+4H, 240→15+60, 60→5+15, 30→3+15, 15→1+5")
biasStr = input.string("Auto", "Bias", options = ["Auto", "Bullish only", "Bearish only"], group = g_bias)

// C2 closure
showLine1     = input.bool(true,                  "Show closure line",                   group = g_lc2)
line1Color    = input.color(color.new(#ff1744, 0),"Color",                                group = g_lc2)
line1Width    = input.int(2, "Width", minval = 1, maxval = 5,                             group = g_lc2)
line1Extra    = input.int(1, "Extension (HTF bars)", minval = 0, maxval = 10,             group = g_lc2)
line1StyleStr = input.string("Solid", "Style", options = ["Solid","Dashed","Dotted"],     group = g_lc2)

// C3 closure
showLine2     = input.bool(true,                  "Show closure line",                   group = g_lc3)
line2Color    = input.color(color.new(#ff9100, 0),"Color",                                group = g_lc3)
line2Width    = input.int(2, "Width", minval = 1, maxval = 5,                             group = g_lc3)
line2Extra    = input.int(1, "Extension (HTF bars)", minval = 0, maxval = 10,             group = g_lc3)
line2StyleStr = input.string("Solid", "Style", options = ["Solid","Dashed","Dotted"],     group = g_lc3)

// Equilibrium box
showBox       = input.bool(true,                  "Show equilibrium box",                 group = g_box)
boxBullColor  = input.color(color.new(#2196f3, 80),"Bull box fill",                       group = g_box)
boxBearColor  = input.color(color.new(#2196f3, 80),"Bear box fill",                       group = g_box)
boxBullBorder = input.color(color.new(#2196f3, 50),"Bull box border",                     group = g_box)
boxBearBorder = input.color(color.new(#2196f3, 50),"Bear box border",                     group = g_box)
boxBorderW    = input.int(1, "Border width", minval = 0, maxval = 3,                      group = g_box)
boxExtraHtf   = input.int(1, "Extension (HTF bars)", minval = 1, maxval = 10,             group = g_box)

// HTF opening line
showOpen      = input.bool(true,                  "Show HTF opening line",                group = g_open)
openColor     = input.color(color.new(#ffcc00, 40),"Color",                               group = g_open)
openWidth     = input.int(1, "Width", minval = 1, maxval = 5,                             group = g_open)
openStyleStr  = input.string("Dotted", "Style", options = ["Solid","Dashed","Dotted"],    group = g_open)
openExtendStr = input.string("Both", "Extend", options = ["Both","Up","Down","None"],     group = g_open)
openHistory   = input.bool(true, "Keep historical opens",                                 group = g_open)

// CISD visuals
cisdAnchorColor  = input.color(color.new(#2563eb, 0), "Anchor line color",        group = g_cisd)
cisdAnchorWidth  = input.int(2, "Anchor line width", minval = 1, maxval = 4,      group = g_cisd)
cisdAnchorStyle  = input.string("Dashed", "Anchor line style", options = ["Solid","Dashed","Dotted"], group = g_cisd)
cisdShowBracket  = input.bool(true,                  "Show consecutive run bracket", group = g_cisd)
cisdBracketColor = input.color(color.new(#7c3aed, 0), "Run bracket color",        group = g_cisd)

// Display
displayDays = input.int(7, "Last N days", minval = 1, maxval = 60, group = g_disp)

// =====================================================================
// Helpers
// =====================================================================
lineStyleFn(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

verticalExtendFn(string e) =>
    e == "Both" ? extend.both : e == "Up" ? extend.right : e == "Down" ? extend.left : extend.none

// =====================================================================
// Aligned timeframe map
// =====================================================================
alignedLtf   = htfStr == "15" ? "1"  : htfStr == "30" ? "3"  : htfStr == "60" ? "5"  : htfStr == "240" ? "15" : htfStr == "1D" ? "60"  : ""
alignedMidTf = htfStr == "15" ? "5"  : htfStr == "30" ? "15" : htfStr == "60" ? "15" : htfStr == "240" ? "60" : htfStr == "1D" ? "240" : ""

chartTf    = timeframe.period
isLtfChart = (alignedLtf   != "") and (chartTf == alignedLtf)
isMidChart = (alignedMidTf != "") and (chartTf == alignedMidTf)
isAligned  = isLtfChart or isMidChart

htfSec     = timeframe.in_seconds(htfStr)
chartSec   = timeframe.in_seconds()
barsPerHtf = chartSec > 0 ? math.max(1, math.round(htfSec / chartSec)) : 1

displayBars = math.round(displayDays * 86400 / math.max(60, chartSec))
inDisplay   = bar_index >= (last_bar_index - displayBars)

allowBull = biasStr == "Auto" or biasStr == "Bullish only"
allowBear = biasStr == "Auto" or biasStr == "Bearish only"

// =====================================================================
// HTF data
// =====================================================================
[htfH1, htfL1, htfC1, htfH2, htfL2, htfC2, htfH3, htfL3] = request.security(syminfo.tickerid, htfStr, [high[1], low[1], close[1], high[2], low[2], close[2], high[3], low[3]], lookahead = barmerge.lookahead_on)

htfStartT   = time(htfStr)
isNewHtfBar = ta.change(htfStartT) != 0

var float currentHtfOpen = na
if isNewHtfBar
    currentHtfOpen := open

// =====================================================================
// Reversal detection
// =====================================================================
canEval = isNewHtfBar and not na(htfL2) and not na(htfH2) and not na(htfC1)

revBull1 = canEval and allowBull and htfL1 < htfL2 and htfC1 > htfL2
revBear1 = canEval and allowBear and htfH1 > htfH2 and htfC1 < htfH2

canEval2   = canEval and not na(htfL3) and not na(htfH3) and not na(htfC2)
c2BullCont = canEval2 and htfL2 < htfL3 and htfC2 < htfL3
c2BearCont = canEval2 and htfH2 > htfH3 and htfC2 > htfH3

revBull2 = canEval2 and allowBull and htfL1 < htfL3 and htfC1 > htfL3 and c2BullCont
revBear2 = canEval2 and allowBear and htfH1 > htfH3 and htfC1 < htfH3 and c2BearCont

// =====================================================================
// HTF opening line (LTF only)
// =====================================================================
canOpen = isLtfChart and showOpen
var line htfOpenLn = na

if canOpen and isNewHtfBar
    if not openHistory and not na(htfOpenLn)
        line.delete(htfOpenLn)
    htfOpenLn := line.new(bar_index, low, bar_index, high, color = openColor, width = openWidth, style = lineStyleFn(openStyleStr), extend = verticalExtendFn(openExtendStr), xloc = xloc.bar_index)

// =====================================================================
// CISD search — STRICTLY within continuation HTF candle's LTF window
//   startBar = bar_index where the continuation HTF candle opened
//   Steps:
//     1. Find the extreme bar (lowest low for bull / highest high for bear)
//        among LTF bars in [startBar, bar_index].
//     2. Walk backward from that extreme to find the consecutive
//        opposite-direction run terminating at/before it. The walk
//        cannot go past startBar.
//     3. Anchor = open of the OLDEST candle in the run.
// =====================================================================
findCisdInWindow(int dir, int startBar) =>
    int   n      = bar_index - startBar
    int   extBar = bar_index
    float extVal = dir == 1 ? low : high
    if n > 0
        for i = 1 to n
            float v = dir == 1 ? low[i] : high[i]
            bool better = dir == 1 ? (v < extVal) : (v > extVal)
            if better
                extVal := v
                extBar := bar_index - i

    int   newRun = na
    int   oldRun = na
    float anch   = na
    int   iter   = extBar
    int   guard  = 0
    while iter >= startBar and guard < 500
        int off = bar_index - iter
        if off >= 0
            bool isOpp = dir == 1 ? (close[off] < open[off]) : (close[off] > open[off])
            if isOpp
                newRun := iter
                break
        iter  -= 1
        guard += 1

    if not na(newRun)
        oldRun := newRun
        int j  = newRun - 1
        int g2 = 0
        while j >= startBar and g2 < 500
            int off = bar_index - j
            bool isOpp = false
            if off >= 0
                isOpp := dir == 1 ? (close[off] < open[off]) : (close[off] > open[off])
            if isOpp
                oldRun := j
                j      -= 1
                g2     += 1
            else
                break
        anch := open[bar_index - oldRun]

    [anch, oldRun, newRun]

// =====================================================================
// Drawing helper
// =====================================================================
drawConfirmed(int dir, float anchor, int oldBar, int newBar, float closeLvl, int closeLeft, float boxOpen, float boxExt, bool isDepth2) =>
    bool   showCloseLine = isDepth2 ? showLine2 : showLine1
    color  cCol          = isDepth2 ? line2Color    : line1Color
    int    cW            = isDepth2 ? line2Width    : line1Width
    string cSt           = isDepth2 ? line2StyleStr : line1StyleStr
    int    cEx           = isDepth2 ? line2Extra    : line1Extra

    if showCloseLine
        line.new(closeLeft, closeLvl, bar_index + barsPerHtf * cEx, closeLvl, color = cCol, width = cW, style = lineStyleFn(cSt), xloc = xloc.bar_index)

    if showBox and not na(boxOpen) and not na(boxExt)
        float eqMid = (boxOpen + boxExt) / 2.0
        int   boxR  = bar_index + barsPerHtf * boxExtraHtf
        if dir == 1
            box.new(bar_index, boxOpen, boxR, eqMid, bgcolor = boxBullColor, border_color = boxBullBorder, border_width = boxBorderW, xloc = xloc.bar_index)
        else
            box.new(bar_index, eqMid, boxR, boxOpen, bgcolor = boxBearColor, border_color = boxBearBorder, border_width = boxBorderW, xloc = xloc.bar_index)

    line.new(oldBar, anchor, bar_index, anchor, color = cisdAnchorColor, width = cisdAnchorWidth, style = lineStyleFn(cisdAnchorStyle), xloc = xloc.bar_index)

    if cisdShowBracket
        float span     = math.abs(high[bar_index - oldBar] - low[bar_index - oldBar])
        float yBracket = dir == 1 ? open[bar_index - oldBar] + span * 0.4 : open[bar_index - oldBar] - span * 0.4
        float yTick    = dir == 1 ? yBracket - span * 0.15 : yBracket + span * 0.15
        line.new(oldBar, yBracket, newBar, yBracket, color = cisdBracketColor, width = 2, xloc = xloc.bar_index)
        line.new(oldBar, yBracket, oldBar, yTick,    color = cisdBracketColor, width = 2, xloc = xloc.bar_index)
        line.new(newBar, yBracket, newBar, yTick,    color = cisdBracketColor, width = 2, xloc = xloc.bar_index)

// =====================================================================
// Pending slots
// =====================================================================
var int    p1Dir       = 0
var int    p1Start     = na
var float  p1CloseLvl  = na
var int    p1CloseLeft = na
var float  p1BoxOpen   = na
var float  p1BoxExt    = na

var int    p2Dir       = 0
var int    p2Start     = na
var float  p2CloseLvl  = na
var int    p2CloseLeft = na
var float  p2BoxOpen   = na
var float  p2BoxExt    = na

// =====================================================================
// Watch FIRST — process existing pending setups before arming new ones
// =====================================================================

// Slot 1
if isAligned and p1Dir != 0 and barstate.isconfirmed
    int barsInto = bar_index - p1Start
    if barsInto >= 0 and barsInto < barsPerHtf
        [anch, oldR, newR] = findCisdInWindow(p1Dir, p1Start)
        if not na(anch) and not na(oldR) and not na(newR)
            bool fired = (p1Dir == 1 and close > anch) or (p1Dir == -1 and close < anch)
            if fired
                drawConfirmed(p1Dir, anch, oldR, newR, p1CloseLvl, p1CloseLeft, p1BoxOpen, p1BoxExt, false)
                p1Dir := 0
    else if barsInto >= barsPerHtf
        p1Dir := 0

// Slot 2
if isAligned and p2Dir != 0 and barstate.isconfirmed
    int barsInto = bar_index - p2Start
    if barsInto >= 0 and barsInto < barsPerHtf
        [anch, oldR, newR] = findCisdInWindow(p2Dir, p2Start)
        if not na(anch) and not na(oldR) and not na(newR)
            bool fired = (p2Dir == 1 and close > anch) or (p2Dir == -1 and close < anch)
            if fired
                drawConfirmed(p2Dir, anch, oldR, newR, p2CloseLvl, p2CloseLeft, p2BoxOpen, p2BoxExt, true)
                p2Dir := 0
    else if barsInto >= barsPerHtf
        p2Dir := 0

// =====================================================================
// Arm AFTER watch — slots are guaranteed clear if previous expired
// =====================================================================

// Arm slot 1 on C2 reversal
if isAligned and inDisplay and (revBull1 or revBear1) and p1Dir == 0
    bool bull   = revBull1
    p1Dir       := bull ? 1 : -1
    p1Start     := bar_index
    p1BoxOpen   := currentHtfOpen
    p1BoxExt    := bull ? htfL1 : htfH1
    p1CloseLvl  := bull ? htfL2 : htfH2
    p1CloseLeft := bar_index - barsPerHtf * 2

// Arm slot 2 on C3 reversal
if isAligned and inDisplay and (revBull2 or revBear2) and p2Dir == 0
    bool bull   = revBull2
    p2Dir       := bull ? 1 : -1
    p2Start     := bar_index
    p2BoxOpen   := currentHtfOpen
    p2BoxExt    := bull ? htfL1 : htfH1
    p2CloseLvl  := bull ? htfL3 : htfH3
    p2CloseLeft := bar_index - barsPerHtf * 3

// =====================================================================
// On-arm-bar fast check — try to fire CISD on the same bar arming happened
// (e.g. very first LTF bar of C3 already closes above an internal anchor)
// =====================================================================

if isAligned and barstate.isconfirmed and p1Dir != 0 and bar_index == p1Start
    [anch, oldR, newR] = findCisdInWindow(p1Dir, p1Start)
    if not na(anch) and not na(oldR) and not na(newR)
        bool fired = (p1Dir == 1 and close > anch) or (p1Dir == -1 and close < anch)
        if fired
            drawConfirmed(p1Dir, anch, oldR, newR, p1CloseLvl, p1CloseLeft, p1BoxOpen, p1BoxExt, false)
            p1Dir := 0

if isAligned and barstate.isconfirmed and p2Dir != 0 and bar_index == p2Start
    [anch, oldR, newR] = findCisdInWindow(p2Dir, p2Start)
    if not na(anch) and not na(oldR) and not na(newR)
        bool fired = (p2Dir == 1 and close > anch) or (p2Dir == -1 and close < anch)
        if fired
            drawConfirmed(p2Dir, anch, oldR, newR, p2CloseLvl, p2CloseLeft, p2BoxOpen, p2BoxExt, true)
            p2Dir := 0
