// Sweep Closure Sequencer [SCS]
// =============================
// Detects 2-bar sweep closures: a candle that takes the prior reference's
// extreme and either closes back beyond it (Reversal) or stays past it
// (Continuation). On every sweep it draws a single horizontal closure line
// at the swept extreme. On Reversal it also draws an equilibrium box from
// the next bar's open to the midpoint of the leg (open(next) <-> swept extreme).
//
// No text, no labels. Lines and boxes only.

//@version=6
indicator("Sweep Closure Sequencer [SCS]", "SCS", overlay = true, max_lines_count = 500, max_boxes_count = 500)

// =====================================================================
// Inputs
// =====================================================================
g_disp = "Display"
g_col  = "Colors"

show_shelf = input.bool(true, "Show closure line",        group = g_disp)
show_eq    = input.bool(true, "Show equilibrium box",     group = g_disp)
eq_extend  = input.int(10,    "Eq box extension (bars)",  minval = 1, maxval = 500, group = g_disp)

c_shelf     = input.color(color.new(color.black, 0),  "Closure line",       group = g_col)
w_shelf     = input.int(2, "Closure line width", minval = 1, maxval = 4,    group = g_col)
c_eq_bull   = input.color(color.new(color.green, 70), "Eq box (bull rev)",  group = g_col)
c_eq_bear   = input.color(color.new(color.red,   70), "Eq box (bear rev)",  group = g_col)
c_eq_border = input.color(color.new(color.gray,  50), "Eq box border",      group = g_col)

// =====================================================================
// State - sentinel values, no na for int vars
// =====================================================================
var int   bearIdx     = -1
var float bearLow     = 0.0
var int   bullIdx     = -1
var float bullHigh    = 0.0

var int   pendBullBar = -1
var float pendBullLow = 0.0
var int   pendBearBar = -1
var float pendBearHi  = 0.0

// =====================================================================
// Lazy initialise on the first bar where we have valid data
// =====================================================================
if bearIdx == -1
    bearIdx  := bar_index
    bearLow  := low
if bullIdx == -1
    bullIdx  := bar_index
    bullHigh := high

// =====================================================================
// Per-bar evaluation (on close)
// =====================================================================
if barstate.isconfirmed and bar_index > 0

    // ---- Bearish ref: low sweep -> bullish reversal candidate ----
    if bearIdx >= 0 and bar_index > bearIdx
        if low < bearLow
            if show_shelf
                line.new(bearIdx, bearLow, bar_index, bearLow, xloc = xloc.bar_index, color = c_shelf, width = w_shelf)
            if close >= bearLow
                pendBullBar := bar_index
                pendBullLow := low
            bearIdx := bar_index
            bearLow := low

    // ---- Bullish ref: high sweep -> bearish reversal candidate ----
    if bullIdx >= 0 and bar_index > bullIdx
        if high > bullHigh
            if show_shelf
                line.new(bullIdx, bullHigh, bar_index, bullHigh, xloc = xloc.bar_index, color = c_shelf, width = w_shelf)
            if close <= bullHigh
                pendBearBar := bar_index
                pendBearHi  := high
            bullIdx  := bar_index
            bullHigh := high

// =====================================================================
// Equilibrium boxes - drawn on the bar AFTER the reversal so we can
// reference that bar's open price.
// =====================================================================
if show_eq
    if pendBullBar >= 0 and bar_index == pendBullBar + 1
        mid = (open + pendBullLow) / 2.0
        box.new(left = bar_index, top = math.max(open, mid), right = bar_index + eq_extend, bottom = math.min(open, mid), xloc = xloc.bar_index, bgcolor = c_eq_bull, border_color = c_eq_border)
        pendBullBar := -1

    if pendBearBar >= 0 and bar_index == pendBearBar + 1
        mid = (open + pendBearHi) / 2.0
        box.new(left = bar_index, top = math.max(open, mid), right = bar_index + eq_extend, bottom = math.min(open, mid), xloc = xloc.bar_index, bgcolor = c_eq_bear, border_color = c_eq_border)
        pendBearBar := -1
