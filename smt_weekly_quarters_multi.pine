// This Pine Script® source code is subject to the terms of the Mozilla Public License 2.0
// © SMT Weekly Quarters - Multi-Pair (NQ/YM, EURUSD/GBPUSD, XAUUSD/XAGUSD)
// Apply on Daily or 1H chart. Each weekly block = 5 daily quarters (Mon -> Fri).
//   Q1 = Mon, Q2 = Tue, Q3 = Wed, Q4 = Thu, Q5 = Fri
// - Within-week SMT: current Q vs prior Qs (XOR sweep on wick extreme)
// - Cross-week SMT: current Q1 vs previous block's Q5
// - Auto-detects pair from chart symbol; supports manual override
// - On 1H chart, SMT lines align to the LTF bar that maps to the daily close

//@version=6
indicator("SMT Weekly Quarters - Multi-Pair", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=200)

// ─── PAIR ─────────────────────────────────────────────────────────────────────
string forceGroup = input.string("Auto", "Pair Group", options=["Auto", "NQ/YM", "EURUSD/GBPUSD", "XAUUSD/XAGUSD"], group="Pair", tooltip="Auto detects from chart ticker; or force a specific pair group.")

string symNQ  = input.symbol("NQ1!",   "NQ Symbol",     group="Pair Symbols")
string symYM  = input.symbol("YM1!",   "YM Symbol",     group="Pair Symbols")
string symEUR = input.symbol("EURUSD", "EURUSD Symbol", group="Pair Symbols")
string symGBP = input.symbol("GBPUSD", "GBPUSD Symbol", group="Pair Symbols")
string symXAU = input.symbol("XAUUSD", "XAUUSD Symbol", group="Pair Symbols")
string symXAG = input.symbol("XAGUSD", "XAGUSD Symbol", group="Pair Symbols")

// ─── DISPLAY ──────────────────────────────────────────────────────────────────
int displayWeeks = input.int(8, "Show Last N Weeks", minval=1, maxval=52, group="Display")

// ─── SMT LINE STYLE ───────────────────────────────────────────────────────────
color  bullLineColor = input.color(color.new(#00e676, 0), "Bull Line Color", group="SMT Line")
color  bearLineColor = input.color(color.new(#ff1744, 0), "Bear Line Color", group="SMT Line")
int    smtLineWidth  = input.int(2, "Line Width", minval=1, maxval=5, group="SMT Line")
string smtLineStyleI = input.string("Solid", "Line Style", options=["Solid", "Dashed", "Dotted"], group="SMT Line")

// ─── SMT LABEL ────────────────────────────────────────────────────────────────
bool   showSmtLabel = input.bool(true, "Show SMT Label", group="SMT Label")
string smtLabelSzI  = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group="SMT Label")

// ─── QUARTER LABEL ────────────────────────────────────────────────────────────
bool  showQLabel  = input.bool(true,  "Show Q Labels (Q1..Q5)", group="Quarter Label")
color qLabelColor = input.color(color.new(color.gray, 0), "Q Label Color", group="Quarter Label")

// ─── WEEK SEPARATOR ──────────────────────────────────────────────────────────
bool   showSep   = input.bool(true,  "Show Week Boundary", group="Week Separator")
color  sepColor  = input.color(color.new(#ffcc00, 60), "Separator Color", group="Week Separator")
string sepStyleI = input.string("Dotted", "Separator Style", options=["Solid", "Dashed", "Dotted"], group="Week Separator")
int    sepWidth  = input.int(1, "Separator Width", minval=1, maxval=3, group="Week Separator")

// ─── PSP ──────────────────────────────────────────────────────────────────────
bool  showPSP     = input.bool(true,  "Show PSP (pair disagreement)", group="PSP")
color pspBgColor  = input.color(color.new(#e040fb, 88), "PSP BG Color",     group="PSP")
color pspBarColor = input.color(color.new(#e040fb, 30), "PSP Candle Color", group="PSP")


// ─── HELPERS ──────────────────────────────────────────────────────────────────
mkLineStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

mkLabelSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

// ─── PAIR DETECTION ──────────────────────────────────────────────────────────
string ticker = syminfo.ticker
bool tNQ  = str.contains(ticker, "NQ")
bool tYM  = str.contains(ticker, "YM")
bool tEUR = str.contains(ticker, "EUR")
bool tGBP = str.contains(ticker, "GBP")
bool tXAU = str.contains(ticker, "XAU")
bool tXAG = str.contains(ticker, "XAG")

string autoGroup   = (tNQ or tYM) ? "NQ/YM" : (tEUR or tGBP) ? "EURUSD/GBPUSD" : (tXAU or tXAG) ? "XAUUSD/XAGUSD" : "NQ/YM"
string activeGroup = forceGroup == "Auto" ? autoGroup : forceGroup

string partnerSym = activeGroup == "NQ/YM" ? (tYM ? symNQ : symYM) : activeGroup == "EURUSD/GBPUSD" ? (tGBP ? symEUR : symGBP) : (tXAG ? symXAU : symXAG)

// ─── TIMEFRAME ───────────────────────────────────────────────────────────────
bool isD  = timeframe.isdaily
bool is1H = timeframe.period == "60"
bool ok   = isD or is1H

// ─── DAILY DATA (always via security; works on any TF) ──────────────────────
[aHd, aLd, aOd, aCd] = request.security(syminfo.tickerid, "D", [high, low, open, close])
[bHd, bLd, bOd, bCd] = request.security(partnerSym,        "D", [high, low, open, close])
int dDow = request.security(syminfo.tickerid, "D", dayofweek(time_close - 1, "America/New_York"))
int dWk  = request.security(syminfo.tickerid, "D", time("W"))

// ─── EVENT (process at each daily close, mapped to the correct LTF bar) ─────
bool dClosed = ta.change(time("D")) != 0
bool evt     = ok and dClosed

// Track first bar of each daily candle so we can box the previous one on 1H
var int firstBarOfDay     = na
var int firstBarOfPrevDay = na
if dClosed and ok
    firstBarOfPrevDay := firstBarOfDay
    firstBarOfDay     := bar_index


// Event-frame values:
//   On Daily chart, the just-closed daily IS the current bar -> use offset 0
//   On 1H chart,    the just-closed daily is one LTF bar ago -> use offset 1
float ev_aH = na, float ev_aL = na, float ev_aO = na, float ev_aC = na
float ev_bH = na, float ev_bL = na, float ev_bO = na, float ev_bC = na
int   ev_dow = 0
int   ev_wk = na, int ev_prevWk = na
int   ev_barIdx = na

if isD
    ev_aH := aHd, ev_aL := aLd, ev_aO := aOd, ev_aC := aCd
    ev_bH := bHd, ev_bL := bLd, ev_bO := bOd, ev_bC := bCd
    ev_dow    := dDow
    ev_wk     := dWk
    ev_prevWk := dWk[1]
    ev_barIdx := bar_index
else if is1H
    ev_aH := aHd[1], ev_aL := aLd[1], ev_aO := aOd[1], ev_aC := aCd[1]
    ev_bH := bHd[1], ev_bL := bLd[1], ev_bO := bOd[1], ev_bC := bCd[1]
    ev_dow    := nz(dDow[1], 0)
    ev_wk     := nz(dWk[1], 0)
    ev_prevWk := nz(dWk[2], 0)
    ev_barIdx := bar_index - 1

// ─── QUARTER ─────────────────────────────────────────────────────────────────
int q = ev_dow == 2 ? 1 : ev_dow == 3 ? 2 : ev_dow == 4 ? 3 : ev_dow == 5 ? 4 : ev_dow == 6 ? 5 : 0
bool blockOn  = q > 0
bool newBlock = evt and ev_wk != nz(ev_prevWk, ev_wk)

// ─── DISPLAY FILTER ──────────────────────────────────────────────────────────
int barsPerWeek = is1H ? 24 * 7 : 7
int displayBars = displayWeeks * barsPerWeek
bool inDisplay  = bar_index >= (last_bar_index - displayBars)


// ─── QUARTER STATE ───────────────────────────────────────────────────────────
var float q1aH = na, var float q1aL = na, var int q1b = na
var float q2aH = na, var float q2aL = na, var int q2b = na
var float q3aH = na, var float q3aL = na, var int q3b = na
var float q4aH = na, var float q4aL = na, var int q4b = na
var float q5aH = na, var float q5aL = na, var int q5b = na
var float q1bH = na, var float q1bL = na
var float q2bH = na, var float q2bL = na
var float q3bH = na, var float q3bL = na
var float q4bH = na, var float q4bL = na
var float q5bH = na, var float q5bL = na

// Cross-block: previous block's Q5
var float pv5aH = na, var float pv5aL = na, var int pv5b = na
var float pv5bH = na, var float pv5bL = na

if evt and newBlock
    pv5aH := q5aH, pv5aL := q5aL, pv5b := q5b
    pv5bH := q5bH, pv5bL := q5bL
    q1aH := na, q1aL := na, q1b := na
    q2aH := na, q2aL := na, q2b := na
    q3aH := na, q3aL := na, q3b := na
    q4aH := na, q4aL := na, q4b := na
    q5aH := na, q5aL := na, q5b := na
    q1bH := na, q1bL := na
    q2bH := na, q2bL := na
    q3bH := na, q3bL := na
    q4bH := na, q4bL := na
    q5bH := na, q5bL := na

if evt and blockOn
    if q == 1
        q1aH := ev_aH, q1aL := ev_aL, q1b := ev_barIdx
        q1bH := ev_bH, q1bL := ev_bL
    else if q == 2
        q2aH := ev_aH, q2aL := ev_aL, q2b := ev_barIdx
        q2bH := ev_bH, q2bL := ev_bL
    else if q == 3
        q3aH := ev_aH, q3aL := ev_aL, q3b := ev_barIdx
        q3bH := ev_bH, q3bL := ev_bL
    else if q == 4
        q4aH := ev_aH, q4aL := ev_aL, q4b := ev_barIdx
        q4bH := ev_bH, q4bL := ev_bL
    else if q == 5
        q5aH := ev_aH, q5aL := ev_aL, q5b := ev_barIdx
        q5bH := ev_bH, q5bL := ev_bL


// ─── PRIOR HIGH/LOW (relaxed - skip missing quarters) ────────────────────────
float pHighA = na, float pHighB = na
int   pHBar  = na
float pLowA  = na, float pLowB  = na
int   pLBar  = na

if evt and blockOn and q >= 2
    if not na(q1aH)
        pHighA := q1aH
        pHBar  := q1b
        pLowA  := q1aL
        pLBar  := q1b
    if not na(q1bH)
        pHighB := q1bH
    if not na(q1bL)
        pLowB := q1bL

    if q >= 3
        if not na(q2aH) and (na(pHighA) or q2aH > pHighA)
            pHighA := q2aH
            pHBar  := q2b
        if not na(q2bH) and (na(pHighB) or q2bH > pHighB)
            pHighB := q2bH
        if not na(q2aL) and (na(pLowA) or q2aL < pLowA)
            pLowA := q2aL
            pLBar := q2b
        if not na(q2bL) and (na(pLowB) or q2bL < pLowB)
            pLowB := q2bL

    if q >= 4
        if not na(q3aH) and (na(pHighA) or q3aH > pHighA)
            pHighA := q3aH
            pHBar  := q3b
        if not na(q3bH) and (na(pHighB) or q3bH > pHighB)
            pHighB := q3bH
        if not na(q3aL) and (na(pLowA) or q3aL < pLowA)
            pLowA := q3aL
            pLBar := q3b
        if not na(q3bL) and (na(pLowB) or q3bL < pLowB)
            pLowB := q3bL

    if q >= 5
        if not na(q4aH) and (na(pHighA) or q4aH > pHighA)
            pHighA := q4aH
            pHBar  := q4b
        if not na(q4bH) and (na(pHighB) or q4bH > pHighB)
            pHighB := q4bH
        if not na(q4aL) and (na(pLowA) or q4aL < pLowA)
            pLowA := q4aL
            pLBar := q4b
        if not na(q4bL) and (na(pLowB) or q4bL < pLowB)
            pLowB := q4bL


// ─── SMT DETECTION (within block, q >= 2) ────────────────────────────────────
bool bear = false
bool bull = false
if evt and blockOn and q >= 2 and not na(pHighA) and not na(pHighB)
    if (ev_aH > pHighA and not (ev_bH > pHighB)) or (ev_bH > pHighB and not (ev_aH > pHighA))
        bear := true
if evt and blockOn and q >= 2 and not na(pLowA) and not na(pLowB)
    if (ev_aL < pLowA and not (ev_bL < pLowB)) or (ev_bL < pLowB and not (ev_aL < pLowA))
        bull := true

// ─── CROSS-BLOCK SMT (Q1 vs prev Q5) ─────────────────────────────────────────
bool crossBear = false
bool crossBull = false
if evt and blockOn and q == 1 and not na(pv5aH) and not na(pv5bH)
    if (ev_aH > pv5aH and not (ev_bH > pv5bH)) or (ev_bH > pv5bH and not (ev_aH > pv5aH))
        crossBear := true
    if (ev_aL < pv5aL and not (ev_bL < pv5bL)) or (ev_bL < pv5bL and not (ev_aL < pv5aL))
        crossBull := true

// ─── DRAW SMT LINES (at LTF bar close) ───────────────────────────────────────
string qTagBlock = "Q" + str.tostring(q)

if bear and not na(pHBar) and inDisplay and barstate.isconfirmed
    line.new(pHBar, pHighA, ev_barIdx, ev_aH, color=bearLineColor, width=smtLineWidth, style=mkLineStyle(smtLineStyleI), xloc=xloc.bar_index)
    if showSmtLabel
        label.new(ev_barIdx, ev_aH, qTagBlock, style=label.style_none, textcolor=bearLineColor, size=mkLabelSize(smtLabelSzI), xloc=xloc.bar_index)

if bull and not na(pLBar) and inDisplay and barstate.isconfirmed
    line.new(pLBar, pLowA, ev_barIdx, ev_aL, color=bullLineColor, width=smtLineWidth, style=mkLineStyle(smtLineStyleI), xloc=xloc.bar_index)
    if showSmtLabel
        label.new(ev_barIdx, ev_aL, qTagBlock, style=label.style_none, textcolor=bullLineColor, size=mkLabelSize(smtLabelSzI), xloc=xloc.bar_index)

if crossBear and not na(pv5b) and inDisplay and barstate.isconfirmed
    line.new(pv5b, pv5aH, ev_barIdx, ev_aH, color=bearLineColor, width=smtLineWidth, style=mkLineStyle(smtLineStyleI), xloc=xloc.bar_index)
    if showSmtLabel
        label.new(ev_barIdx, ev_aH, "Q1*", style=label.style_none, textcolor=bearLineColor, size=mkLabelSize(smtLabelSzI), xloc=xloc.bar_index)

if crossBull and not na(pv5b) and inDisplay and barstate.isconfirmed
    line.new(pv5b, pv5aL, ev_barIdx, ev_aL, color=bullLineColor, width=smtLineWidth, style=mkLineStyle(smtLineStyleI), xloc=xloc.bar_index)
    if showSmtLabel
        label.new(ev_barIdx, ev_aL, "Q1*", style=label.style_none, textcolor=bullLineColor, size=mkLabelSize(smtLabelSzI), xloc=xloc.bar_index)


// ─── QUARTER LABELS (one per daily; centered under the daily on 1H) ─────────
if ok and showQLabel and blockOn and inDisplay and barstate.isconfirmed and evt
    int qLblBar = is1H and not na(firstBarOfPrevDay) ? math.round((firstBarOfPrevDay + ev_barIdx) / 2) : ev_barIdx
    label.new(qLblBar, ev_aL, "Q" + str.tostring(q), style=label.style_none, textcolor=qLabelColor, size=size.tiny, yloc=yloc.belowbar, xloc=xloc.bar_index)

// ─── PSP ─────────────────────────────────────────────────────────────────────
bool aBull = ev_aC > ev_aO
bool bBull = ev_bC > ev_bO
bool isPSP = evt and blockOn and (aBull != bBull) and inDisplay

// Daily: color the candle body + tint background of the bar
bool isDailyPSP = isD and isPSP
barcolor(showPSP and isDailyPSP ? pspBarColor : na, title="PSP Bar Color")
bgcolor (showPSP and isDailyPSP ? pspBgColor  : na, title="PSP BG")

// 1H: draw a translucent box over the just-closed PSP daily's range
if is1H and isPSP and showPSP and inDisplay and barstate.isconfirmed and not na(firstBarOfPrevDay)
    box.new(firstBarOfPrevDay, ev_aH, bar_index - 1, ev_aL, bgcolor=pspBgColor, border_color=color.new(color.black, 100), xloc=xloc.bar_index)

// ─── WEEK SEPARATOR ──────────────────────────────────────────────────────────
if showSep and inDisplay and barstate.isconfirmed and evt and newBlock
    int sepBarIdx = isD ? bar_index : nz(firstBarOfPrevDay, bar_index - 1)
    line.new(sepBarIdx, high, sepBarIdx, low, extend=extend.both, color=sepColor, style=mkLineStyle(sepStyleI), width=sepWidth, xloc=xloc.bar_index)

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(bull or crossBull, title="Bull SMT", message="Bull SMT Weekly Quarters")
alertcondition(bear or crossBear, title="Bear SMT", message="Bear SMT Weekly Quarters")
