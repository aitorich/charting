// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// © [Astrophile] - Key Levels
// FVG (Fair Value Gap) + Swing High/Low + C2/C3 Closure at Key Levels
// Key levels hide when mitigated (price trades through them)
// C2 ideal closure = sweep + close back through level → line at swept level
// C3 closure = C2 failed (closed through) → C3 closes above/below C2 open → line at C2 open
// Works on 15m+ timeframes. N days lookback.

//@version=6
indicator("[Astrophile] - Key Levels", overlay=true, max_boxes_count=500, max_lines_count=500)

// ─── DISPLAY ──────────────────────────────────────────────────────────────────
int displayDays = input.int(3, "Show Last N Days", minval=1, maxval=20, group="Display")

// ─── BULLISH FVG STYLE ────────────────────────────────────────────────────────
bool showBullFVG      = input.bool(true, "Show Bullish FVG", group="Bullish FVG")
color bullFVGColor    = input.color(color.new(#00e676, 80), "Bullish FVG Color", group="Bullish FVG")
color bullBorderColor = input.color(color.new(#00e676, 50), "Bullish Border Color", group="Bullish FVG")
int bullBorderWidth   = input.int(1, "Bullish Border Width", minval=0, maxval=3, group="Bullish FVG")

// ─── BEARISH FVG STYLE ────────────────────────────────────────────────────────
bool showBearFVG      = input.bool(true, "Show Bearish FVG", group="Bearish FVG")
color bearFVGColor    = input.color(color.new(#ff1744, 80), "Bearish FVG Color", group="Bearish FVG")
color bearBorderColor = input.color(color.new(#ff1744, 50), "Bearish Border Color", group="Bearish FVG")
int bearBorderWidth   = input.int(1, "Bearish Border Width", minval=0, maxval=3, group="Bearish FVG")

// ─── FVG BOX SETTINGS ─────────────────────────────────────────────────────────
int boxExtend = input.int(5, "FVG Box Extend (bars right)", minval=1, maxval=20, group="FVG Box")

// ─── SWING SETTINGS ───────────────────────────────────────────────────────────
int swingStrength = input.int(2, "Swing Strength (bars each side)", minval=1, maxval=10, group="Swing Detection")

// ─── SWING HIGH STYLE ─────────────────────────────────────────────────────────
bool showSwingH    = input.bool(true, "Show Swing High", group="Swing High")
color swingHColor  = input.color(color.new(#ff1744, 0), "Swing High Color", group="Swing High")
int swingHWidth    = input.int(1, "Swing High Width", minval=1, maxval=5, group="Swing High")
string swingHStyle = input.string("Solid", "Swing High Style", options=["Solid", "Dashed", "Dotted"], group="Swing High")
int swingHExtend   = input.int(10, "Swing High Extend (bars)", minval=1, maxval=50, group="Swing High")

// ─── SWING LOW STYLE ──────────────────────────────────────────────────────────
bool showSwingL    = input.bool(true, "Show Swing Low", group="Swing Low")
color swingLColor  = input.color(color.new(#00e676, 0), "Swing Low Color", group="Swing Low")
int swingLWidth    = input.int(1, "Swing Low Width", minval=1, maxval=5, group="Swing Low")
string swingLStyle = input.string("Solid", "Swing Low Style", options=["Solid", "Dashed", "Dotted"], group="Swing Low")
int swingLExtend   = input.int(10, "Swing Low Extend (bars)", minval=1, maxval=50, group="Swing Low")

// ─── MITIGATION ───────────────────────────────────────────────────────────────
bool hideMitigated = input.bool(true, "Hide Mitigated Levels", group="Mitigation")

// ─── C2 IDEAL CLOSURE STYLE ──────────────────────────────────────────────────
bool showC2       = input.bool(true, "Show C2 Ideal Closure", group="C2 Closure")
color c2BullColor = input.color(color.new(#ff1744, 0), "C2 Bullish Color", group="C2 Closure")
color c2BearColor = input.color(color.new(#ff1744, 0), "C2 Bearish Color", group="C2 Closure")
int c2LineWidth   = input.int(1, "C2 Line Width", minval=1, maxval=5, group="C2 Closure")
string c2LineStyleStr = input.string("Solid", "C2 Line Style", options=["Solid", "Dashed", "Dotted"], group="C2 Closure")
int c2ExtraBars   = input.int(1, "C2 Extra Bars", minval=0, maxval=5, group="C2 Closure")

// ─── C3 CLOSURE STYLE ────────────────────────────────────────────────────────
bool showC3       = input.bool(true, "Show C3 Closure", group="C3 Closure")
color c3BullColor = input.color(color.new(#2196f3, 0), "C3 Bullish Color", group="C3 Closure")
color c3BearColor = input.color(color.new(#2196f3, 0), "C3 Bearish Color", group="C3 Closure")
int c3LineWidth   = input.int(1, "C3 Line Width", minval=1, maxval=5, group="C3 Closure")
string c3LineStyleStr = input.string("Dashed", "C3 Line Style", options=["Solid", "Dashed", "Dotted"], group="C3 Closure")
int c3ExtraBars   = input.int(1, "C3 Extra Bars", minval=0, maxval=5, group="C3 Closure")

// ─── HELPERS ──────────────────────────────────────────────────────────────────
lineStyle(string s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

// ─── N DAYS DISPLAY FILTER ────────────────────────────────────────────────────
int barsPerDay = timeframe.in_seconds() > 0 ? math.round(86400 / timeframe.in_seconds()) : 24
int displayBars = displayDays * barsPerDay
bool inDisplay = bar_index >= (last_bar_index - displayBars)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── FVG DETECTION ────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

float bullFVGTop = low
float bullFVGBot = high[2]
bool bullFVG = bullFVGTop > bullFVGBot

float bearFVGTop = low[2]
float bearFVGBot = high
bool bearFVG = bearFVGBot < bearFVGTop

var float[] bullFVGTops = array.new_float(0)
var float[] bullFVGBots = array.new_float(0)
var array<box> bullFVGBoxes = array.new<box>(0)
var bool[] bullFVGMitigated = array.new_bool(0)

var float[] bearFVGTops = array.new_float(0)
var float[] bearFVGBots = array.new_float(0)
var array<box> bearFVGBoxes = array.new<box>(0)
var bool[] bearFVGMitigated = array.new_bool(0)

if bullFVG
    array.push(bullFVGTops, bullFVGTop)
    array.push(bullFVGBots, bullFVGBot)
    array.push(bullFVGMitigated, false)
    if inDisplay and showBullFVG
        array.push(bullFVGBoxes, box.new(bar_index - 1, bullFVGTop, bar_index + boxExtend, bullFVGBot, bgcolor=bullFVGColor, border_color=bullBorderColor, border_width=bullBorderWidth))
    else
        array.push(bullFVGBoxes, na)
    if array.size(bullFVGTops) > 30
        array.shift(bullFVGTops)
        array.shift(bullFVGBots)
        array.shift(bullFVGMitigated)
        box old = array.shift(bullFVGBoxes)
        if not na(old)
            box.delete(old)

if bearFVG
    array.push(bearFVGTops, bearFVGTop)
    array.push(bearFVGBots, bearFVGBot)
    array.push(bearFVGMitigated, false)
    if inDisplay and showBearFVG
        array.push(bearFVGBoxes, box.new(bar_index - 1, bearFVGTop, bar_index + boxExtend, bearFVGBot, bgcolor=bearFVGColor, border_color=bearBorderColor, border_width=bearBorderWidth))
    else
        array.push(bearFVGBoxes, na)
    if array.size(bearFVGTops) > 30
        array.shift(bearFVGTops)
        array.shift(bearFVGBots)
        array.shift(bearFVGMitigated)
        box old = array.shift(bearFVGBoxes)
        if not na(old)
            box.delete(old)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── SWING DETECTION ──────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

float swH = ta.pivothigh(high, swingStrength, swingStrength)
float swL = ta.pivotlow(low, swingStrength, swingStrength)

var float[] swingHighs = array.new_float(0)
var array<line> swingHLines = array.new<line>(0)
var bool[] swingHMitigated = array.new_bool(0)

var float[] swingLows  = array.new_float(0)
var array<line> swingLLines = array.new<line>(0)
var bool[] swingLMitigated = array.new_bool(0)

if not na(swH)
    array.push(swingHighs, swH)
    array.push(swingHMitigated, false)
    if inDisplay and showSwingH
        array.push(swingHLines, line.new(bar_index - swingStrength, swH, bar_index - swingStrength + swingHExtend, swH, color=swingHColor, width=swingHWidth, style=lineStyle(swingHStyle)))
    else
        array.push(swingHLines, na)
    if array.size(swingHighs) > 30
        array.shift(swingHighs)
        array.shift(swingHMitigated)
        line old = array.shift(swingHLines)
        if not na(old)
            line.delete(old)

if not na(swL)
    array.push(swingLows, swL)
    array.push(swingLMitigated, false)
    if inDisplay and showSwingL
        array.push(swingLLines, line.new(bar_index - swingStrength, swL, bar_index - swingStrength + swingLExtend, swL, color=swingLColor, width=swingLWidth, style=lineStyle(swingLStyle)))
    else
        array.push(swingLLines, na)
    if array.size(swingLows) > 30
        array.shift(swingLows)
        array.shift(swingLMitigated)
        line old = array.shift(swingLLines)
        if not na(old)
            line.delete(old)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── MITIGATION: hide levels that price has traded through ────────────────────
// ═══════════════════════════════════════════════════════════════════════════════

if hideMitigated
    if array.size(swingHighs) > 0
        for i = array.size(swingHighs) - 1 to 0
            if not array.get(swingHMitigated, i)
                if close > array.get(swingHighs, i)
                    array.set(swingHMitigated, i, true)
                    line ln = array.get(swingHLines, i)
                    if not na(ln)
                        line.delete(ln)

    if array.size(swingLows) > 0
        for i = array.size(swingLows) - 1 to 0
            if not array.get(swingLMitigated, i)
                if close < array.get(swingLows, i)
                    array.set(swingLMitigated, i, true)
                    line ln = array.get(swingLLines, i)
                    if not na(ln)
                        line.delete(ln)

    if array.size(bullFVGBots) > 0
        for i = array.size(bullFVGBots) - 1 to 0
            if not array.get(bullFVGMitigated, i)
                if close < array.get(bullFVGBots, i)
                    array.set(bullFVGMitigated, i, true)
                    box bx = array.get(bullFVGBoxes, i)
                    if not na(bx)
                        box.delete(bx)

    if array.size(bearFVGTops) > 0
        for i = array.size(bearFVGTops) - 1 to 0
            if not array.get(bearFVGMitigated, i)
                if close > array.get(bearFVGTops, i)
                    array.set(bearFVGMitigated, i, true)
                    box bx = array.get(bearFVGBoxes, i)
                    if not na(bx)
                        box.delete(bx)

// ═══════════════════════════════════════════════════════════════════════════════
// ─── C2 / C3 AT KEY LEVEL ─────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════════
// C2 ideal closure (instant reversal):
//   Bullish: C2 sweeps C1 low AND closes back above C1 low
//   Bearish: C2 sweeps C1 high AND closes back below C1 high
//   → horizontal line at swept level (C1 low / C1 high)
//
// C2 IDEAL (stronger): C2 sweeps AND closes above/below C1's OPEN
//   → same marking as C3: horizontal line at C1 open level (dashed)
//
// C3 closure (delayed reversal — C2 failed):
//   Bullish: C2 swept C1 low but closed below it (failed) → C3 closes above C2 open
//   Bearish: C2 swept C1 high but closed above it (failed) → C3 closes below C2 open
//   → horizontal line at C2 open level

// ─── Raw C2 sweep detection ──────────────────────────────────────────────────
// Regular C2: sweeps C1 low/high, closes back through C1 low/high
bool c2Bull = (low < low[1]) and (close > low[1])
bool c2Bear = (high > high[1]) and (close < high[1])

// Ideal C2: sweeps C1 low/high AND closes above/below C1's OPEN (stronger)
bool c2IdealBull = c2Bull and (close > open[1])    // swept C1 low, closed above C1 open
bool c2IdealBear = c2Bear and (close < open[1])    // swept C1 high, closed below C1 open

// C2 failed (swept but closed through the wrong side)
bool c2FailedBull = (low[1] < low[2]) and (close[1] < low[2])   // C2 swept C1 low but closed below
bool c2FailedBear = (high[1] > high[2]) and (close[1] > high[2]) // C2 swept C1 high but closed above

// C3 confirmation (reversal after failed C2)
bool c3Bull = c2FailedBull and (close > open[1])   // C3 closes above C2 open
bool c3Bear = c2FailedBear and (close < open[1])   // C3 closes below C2 open

// ─── Check if C2/C3 occurred at a key level (swing or FVG) ───────────────────
bool c2BullAtKL = false
bool c2BearAtKL = false
bool c2IdealBullAtKL = false
bool c2IdealBearAtKL = false
bool c3BullAtKL = false
bool c3BearAtKL = false

// C2 bull at swing low
if c2Bull and inDisplay and array.size(swingLows) > 0
    for i = array.size(swingLows) - 1 to 0
        if not array.get(swingLMitigated, i)
            float level = array.get(swingLows, i)
            if low <= level and close > level
                c2BullAtKL := true
                break

// C2 bull at bullish FVG
if c2Bull and inDisplay and not c2BullAtKL and array.size(bullFVGTops) > 0
    for i = array.size(bullFVGTops) - 1 to 0
        if not array.get(bullFVGMitigated, i)
            float fTop = array.get(bullFVGTops, i)
            float fBot = array.get(bullFVGBots, i)
            if low <= fTop and low >= fBot
                c2BullAtKL := true
                break

// C2 bear at swing high
if c2Bear and inDisplay and array.size(swingHighs) > 0
    for i = array.size(swingHighs) - 1 to 0
        if not array.get(swingHMitigated, i)
            float level = array.get(swingHighs, i)
            if high >= level and close < level
                c2BearAtKL := true
                break

// C2 bear at bearish FVG
if c2Bear and inDisplay and not c2BearAtKL and array.size(bearFVGTops) > 0
    for i = array.size(bearFVGTops) - 1 to 0
        if not array.get(bearFVGMitigated, i)
            float fTop = array.get(bearFVGTops, i)
            float fBot = array.get(bearFVGBots, i)
            if high >= fBot and high <= fTop
                c2BearAtKL := true
                break

// Ideal C2 bull at key level (same check but requires ideal condition)
if c2IdealBull and inDisplay and c2BullAtKL
    c2IdealBullAtKL := true

// Ideal C2 bear at key level
if c2IdealBear and inDisplay and c2BearAtKL
    c2IdealBearAtKL := true

// C3 bull at swing low (check C2's sweep on previous bar)
if c3Bull and inDisplay and array.size(swingLows) > 0
    for i = array.size(swingLows) - 1 to 0
        if not array.get(swingLMitigated, i)
            float level = array.get(swingLows, i)
            if low[1] <= level
                c3BullAtKL := true
                break

// C3 bull at bullish FVG
if c3Bull and inDisplay and not c3BullAtKL and array.size(bullFVGTops) > 0
    for i = array.size(bullFVGTops) - 1 to 0
        if not array.get(bullFVGMitigated, i)
            float fTop = array.get(bullFVGTops, i)
            float fBot = array.get(bullFVGBots, i)
            if low[1] <= fTop and low[1] >= fBot
                c3BullAtKL := true
                break

// C3 bear at swing high
if c3Bear and inDisplay and array.size(swingHighs) > 0
    for i = array.size(swingHighs) - 1 to 0
        if not array.get(swingHMitigated, i)
            float level = array.get(swingHighs, i)
            if high[1] >= level
                c3BearAtKL := true
                break

// C3 bear at bearish FVG
if c3Bear and inDisplay and not c3BearAtKL and array.size(bearFVGTops) > 0
    for i = array.size(bearFVGTops) - 1 to 0
        if not array.get(bearFVGMitigated, i)
            float fTop = array.get(bearFVGTops, i)
            float fBot = array.get(bearFVGBots, i)
            if high[1] >= fBot and high[1] <= fTop
                c3BearAtKL := true
                break

// ─── DRAW C2 REGULAR (horizontal line at swept level) ─────────────────────────
if showC2 and c2BullAtKL and inDisplay
    line.new(bar_index - 1, low[1], bar_index + c2ExtraBars, low[1], color=c2BullColor, width=c2LineWidth, style=lineStyle(c2LineStyleStr))

if showC2 and c2BearAtKL and inDisplay
    line.new(bar_index - 1, high[1], bar_index + c2ExtraBars, high[1], color=c2BearColor, width=c2LineWidth, style=lineStyle(c2LineStyleStr))

// ─── DRAW C2 IDEAL CLOSURE (horizontal line at C1's open — same style as C3) ─
if showC3 and c2IdealBullAtKL and inDisplay
    line.new(bar_index - 1, open[1], bar_index + c3ExtraBars, open[1], color=c3BullColor, width=c3LineWidth, style=lineStyle(c3LineStyleStr))

if showC3 and c2IdealBearAtKL and inDisplay
    line.new(bar_index - 1, open[1], bar_index + c3ExtraBars, open[1], color=c3BearColor, width=c3LineWidth, style=lineStyle(c3LineStyleStr))

// ─── DRAW C3 CLOSURE (horizontal line at C2's open) ──────────────────────────
if showC3 and c3BullAtKL and inDisplay
    line.new(bar_index - 1, open[1], bar_index + c3ExtraBars, open[1], color=c3BullColor, width=c3LineWidth, style=lineStyle(c3LineStyleStr))

if showC3 and c3BearAtKL and inDisplay
    line.new(bar_index - 1, open[1], bar_index + c3ExtraBars, open[1], color=c3BearColor, width=c3LineWidth, style=lineStyle(c3LineStyleStr))

// ─── ALERTS ──────────────────────────────────────────────────────────────────
alertcondition(bullFVG, title="Bullish FVG", message="Bullish FVG {{ticker}}")
alertcondition(bearFVG, title="Bearish FVG", message="Bearish FVG {{ticker}}")
alertcondition(not na(swH), title="Swing High", message="Swing High {{ticker}}")
alertcondition(not na(swL), title="Swing Low", message="Swing Low {{ticker}}")
alertcondition(c2BullAtKL, title="C2 Bull at Key Level", message="C2 Bullish closure at key level {{ticker}}")
alertcondition(c2BearAtKL, title="C2 Bear at Key Level", message="C2 Bearish closure at key level {{ticker}}")
alertcondition(c2IdealBullAtKL, title="C2 Ideal Bull", message="C2 Ideal bullish closure at key level {{ticker}}")
alertcondition(c2IdealBearAtKL, title="C2 Ideal Bear", message="C2 Ideal bearish closure at key level {{ticker}}")
alertcondition(c3BullAtKL, title="C3 Bull at Key Level", message="C3 Bullish closure at key level {{ticker}}")
alertcondition(c3BearAtKL, title="C3 Bear at Key Level", message="C3 Bearish closure at key level {{ticker}}")
