// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Original ICT HTF Candles by fadizeidan
// Modified: single auto-selected HTF based on chart TF + HTF Opening Line on LTF chart
//
// Auto LTF -> HTF mapping:
//   1m  -> 15m
//   3m  -> 30m
//   5m  -> 1H
//   15m -> 4H
//   30m -> 1D
//   1H  -> 1D
//   4H  -> 1W
// Other chart TFs are not supported and a warning label is shown.

//@version=6
indicator('ICT HTF Candles Auto (single HTF + Open Line)', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 5000)

// =====================================================================
// Types
// =====================================================================
type Candle
    float o
    float c
    float h
    float l
    int   o_time
    int   o_idx
    int   c_idx
    int   h_idx
    int   l_idx
    string dow
    box   body
    line  wick_up
    line  wick_down
    label dow_label
    line  open_line
    label open_label

type Trace
    line o
    line c
    line h
    line l
    label o_l
    label c_l
    label h_l
    label l_l

type Imbalance
    box b
    int idx

// =====================================================================
// Inputs
// =====================================================================
string g_main      = "Main  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string g_oline     = "HTF Opening Line  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string g_style     = "Styling  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string g_label     = "Label Settings  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string g_imb       = "Imbalance  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
string g_trace     = "Trace  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

int    in_max_display    = input.int(5, 'HTF candles to show', minval = 1, maxval = 20, group = g_main)
bool   in_use_cust_daily = input.bool(false, 'Custom daily candle open', inline = 'cd', group = g_main)
string in_cust_daily     = input.string('Midnight', '', options = ['Midnight', '8:30', '9:30'], inline = 'cd', group = g_main)

// HTF opening line (drawn on the LTF chart)
bool   in_ol_show     = input.bool(true, 'Show HTF Opening Line', group = g_oline)
color  in_ol_color    = input.color(color.new(color.blue, 0), 'Color  ', inline = 'ol', group = g_oline)
string in_ol_style    = input.string('⎯⎯⎯', '', options = ['⎯⎯⎯', '----', '····'], inline = 'ol', group = g_oline)
int    in_ol_width    = input.int(1, '', options = [1, 2, 3, 4], inline = 'ol', group = g_oline)
bool   in_ol_history  = input.bool(false, 'Keep historical HTF opens (one per past HTF candle)', group = g_oline)
bool   in_ol_label    = input.bool(true, 'Show price label', group = g_oline)

// Styling (kept from original)
color  in_bull_body    = input.color(color.new(color.green, 10), 'Body  ',    inline = 'body',    group = g_style)
color  in_bear_body    = input.color(color.new(color.red,   10), '',           inline = 'body',    group = g_style)
color  in_bull_border  = input.color(color.new(color.black, 10), 'Borders',   inline = 'borders', group = g_style)
color  in_bear_border  = input.color(color.new(color.black, 10), '',           inline = 'borders', group = g_style)
color  in_bull_wick    = input.color(color.new(color.black, 10), 'Wick  ',    inline = 'wick',    group = g_style)
color  in_bear_wick    = input.color(color.new(color.black, 10), '',           inline = 'wick',    group = g_style)
int    in_offset       = input.int(10, 'padding from current candles', minval = 1,            group = g_style)
int    in_buffer       = input.int(1,  'space between candles',         minval = 1, maxval = 4, group = g_style)
int    in_width        = input.int(1,  'Candle Width',                  minval = 1, maxval = 4, group = g_style) * 2

// Labels (kept from original)
bool   in_lbl_show     = input.bool(true, 'HTF Label           ', group = g_label, inline = 'HTFlabel')
color  in_lbl_color    = input.color(color.new(color.black, 10), '', group = g_label, inline = 'HTFlabel')
string in_lbl_size     = input.string(size.large, '', [size.tiny, size.small, size.normal, size.large, size.huge], group = g_label, inline = 'HTFlabel')
string in_lbl_pos      = input.string("Both", 'Label Positions',  options = ['Both', 'Top', 'Bottom'], group = g_label)
string in_lbl_align    = input.string("Align", "Label Alignment", options = ['Align', 'Follow Candles'], group = g_label)
bool   in_tmr_show     = input.bool(true, 'Remaining time      ', inline = 'timer', group = g_label)
color  in_tmr_color    = input.color(color.new(color.black, 10), '', inline = 'timer', group = g_label)
string in_tmr_size     = input.string(size.normal, '', [size.tiny, size.small, size.normal, size.large, size.huge], group = g_label, inline = 'timer')
bool   in_dow_show     = input.bool(false, 'Interval Value        ', group = g_label, inline = 'dow')
color  in_dow_color    = input.color(color.black,                  '', group = g_label, inline = 'dow')
string in_dow_size     = input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], group = g_label, inline = 'dow')

// Imbalance (kept from original)
bool   in_fvg_show     = input.bool(true, 'Fair Value Gap   ', group = g_imb, inline = 'fvg')
color  in_fvg_color    = input.color(color.new(color.gray, 80), '', inline = 'fvg', group = g_imb)
bool   in_vi_show      = input.bool(true, 'Volume Imbalance', group = g_imb, inline = 'vi')
color  in_vi_color     = input.color(color.new(color.red, 50), '', inline = 'vi', group = g_imb)

// Trace (kept from original)
bool   in_tr_show      = input.bool(false, 'Trace lines', group = g_trace)
color  in_tr_o_color   = input.color(color.new(color.gray, 50), 'Open    ', inline = '1', group = g_trace)
string in_tr_o_style   = input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '1', group = g_trace)
int    in_tr_o_size    = input.int(1, '', options = [1, 2, 3, 4], inline = '1', group = g_trace)
color  in_tr_c_color   = input.color(color.new(color.gray, 50), 'Close    ', inline = '2', group = g_trace)
string in_tr_c_style   = input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '2', group = g_trace)
int    in_tr_c_size    = input.int(1, '', options = [1, 2, 3, 4], inline = '2', group = g_trace)
color  in_tr_h_color   = input.color(color.new(color.gray, 50), 'High     ', inline = '3', group = g_trace)
string in_tr_h_style   = input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '3', group = g_trace)
int    in_tr_h_size    = input.int(1, '', options = [1, 2, 3, 4], inline = '3', group = g_trace)
color  in_tr_l_color   = input.color(color.new(color.gray, 50), 'Low     ', inline = '4', group = g_trace)
string in_tr_l_style   = input.string('····', '', options = ['⎯⎯⎯', '----', '····'], inline = '4', group = g_trace)
int    in_tr_l_size    = input.int(1, '', options = [1, 2, 3, 4], inline = '4', group = g_trace)
bool   in_pl_show      = input.bool(false, 'Price Label           ', inline = 'plabel')
color  in_pl_color     = input.color(color.new(color.black, 10), '', inline = 'plabel')
string in_pl_size      = input.string(size.small, '', [size.tiny, size.small, size.normal, size.large, size.huge], inline = 'plabel')

color color_transparent = #ffffff00

// =====================================================================
// Auto HTF mapping  (only the user-supported chart timeframes)
// =====================================================================
chartSec = timeframe.in_seconds()
chartMin = chartSec / 60

string htf       = na
bool   valid_tf  = false

if chartMin == 1
    htf := '15'
    valid_tf := true
else if chartMin == 3
    htf := '30'
    valid_tf := true
else if chartMin == 5
    htf := '60'
    valid_tf := true
else if chartMin == 15
    htf := '240'
    valid_tf := true
else if chartMin == 30
    htf := '1D'
    valid_tf := true
else if chartMin == 60
    htf := '1D'
    valid_tf := true
else if chartMin == 240
    htf := '1W'
    valid_tf := true

// Warn user when chart TF is not supported
var label warn = na
if barstate.islast
    if not na(warn)
        label.delete(warn)
        warn := na
    if not valid_tf
        warn := label.new(bar_index, high, "Unsupported chart TF: use 1m, 3m, 5m, 15m, 30m, 1H or 4H", style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.normal)

// =====================================================================
// State
// =====================================================================
var array<Candle>    candles    = array.new<Candle>(0)
var array<Imbalance> imbalances = array.new<Imbalance>()
var label tfNameTop      = na
var label tfNameBottom   = na
var label tfTimerTop     = na
var label tfTimerBottom  = na
var Trace trace          = Trace.new()

// =====================================================================
// Helpers
// =====================================================================
f_lineStyle(string s) =>
    out = switch s
        '----' => line.style_dashed
        '····' => line.style_dotted
        =>        line.style_solid
    out

f_dow(int idx) =>
    switch
        idx == 1 => 'M'
        idx == 2 => 'T'
        idx == 3 => 'W'
        idx == 4 => 'T'
        idx == 5 => 'F'
        idx == 6 => 'S'
        idx == 7 => 'S'
        na(idx)  => ''

f_remaining(string HTF) =>
    if barstate.isrealtime
        rem = (time_close(HTF) - timenow) / 1000
        d = math.floor(rem / 86400)
        h = math.floor((rem - d * 86400) / 3600)
        m = math.floor((rem - d * 86400 - h * 3600) / 60)
        s = math.floor(rem - d * 86400 - h * 3600 - m * 60)
        r = str.tostring(s, '00')
        if m > 0 or h > 0 or d > 0
            r := str.tostring(m, '00') + ':' + r
        if h > 0 or d > 0
            r := str.tostring(h, '00') + ':' + r
        if d > 0
            r := str.tostring(d) + 'D ' + r
        r
    else
        'n/a'

f_htfName(string HTF) =>
    sec = timeframe.in_seconds(HTF)
    out = HTF
    if sec < 60
        out := str.tostring(sec) + 's'
    else if sec / 60 < 60
        out := str.tostring(sec / 60) + 'm'
    else if sec / 60 / 60 < 24
        out := str.tostring(sec / 60 / 60) + 'H'
    out

f_setHigh(array<Candle> arr) =>
    h = 0.0
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Candle c = arr.get(i)
            if c.h > h
                h := c.h
    h

f_setLow(array<Candle> arr, float top) =>
    l = top
    if arr.size() > 0
        for i = 0 to arr.size() - 1
            Candle c = arr.get(i)
            if c.l < l
                l := c.l
    l

// =====================================================================
// Main
// =====================================================================
if valid_tf

    // ---- detect new HTF candle ----
    HTFTime       = time(htf, 'America/New_York')
    isNewHTF      = ta.change(HTFTime) > 0

    if in_use_cust_daily and htf == '1D'
        if in_cust_daily == 'Midnight'
            isNewHTF := dayofweek(time, 'America/New_York') != dayofweek(time - (time - time[1]), 'America/New_York')
        if in_cust_daily == '8:30'
            isNewHTF := not na(time(timeframe.period, "0830-0831:123456", 'America/New_York')) and na(time(timeframe.period, "0830-0831:123456", 'America/New_York')[1])
        if in_cust_daily == '9:30'
            isNewHTF := not na(time(timeframe.period, "0930-0931:123456", 'America/New_York')) and na(time(timeframe.period, "0930-0931:123456", 'America/New_York')[1])

    // ---- on new HTF candle: close opening line of previous candle, push new candle ----
    if isNewHTF
        // close previous opening line at current bar (so it stops at the boundary)
        if candles.size() > 0
            Candle prev = candles.first()
            if not na(prev.open_line)
                line.set_extend(prev.open_line, extend.none)
                line.set_x2(prev.open_line, bar_index - 1)

        Candle nc = Candle.new()
        nc.o      := open
        nc.c      := close
        nc.h      := high
        nc.l      := low
        nc.o_time := time
        nc.o_idx  := bar_index
        nc.c_idx  := bar_index
        nc.h_idx  := bar_index
        nc.l_idx  := bar_index
        nc.dow    := switch
            htf == '1D'                     => f_dow(dayofweek(time_tradingday, "America/New_York"))
            str.tonumber(htf) < 60          => str.format_time(nc.o_time, 'm', 'America/New_York')
            str.tonumber(htf) >= 60         => str.format_time(nc.o_time, 'H', 'America/New_York')
            =>                                ''

        bool bull = nc.c > nc.o
        nc.body      := box.new(bar_index, math.max(nc.o, nc.c), bar_index + 2, math.min(nc.o, nc.c), bull ? in_bull_border : in_bear_border, 1, bgcolor = bull ? in_bull_body : in_bear_body)
        nc.wick_up   := line.new(bar_index + 1, nc.h, bar_index, math.max(nc.o, nc.c), color = bull ? in_bull_wick : in_bear_wick)
        nc.wick_down := line.new(bar_index + 1, math.min(nc.o, nc.c), bar_index, nc.l, color = bull ? in_bull_wick : in_bear_wick)

        candles.unshift(nc)

        // trim oldest beyond max_display, and clean up its visuals
        while candles.size() > in_max_display
            Candle del = array.pop(candles)
            box.delete(del.body)
            line.delete(del.wick_up)
            line.delete(del.wick_down)
            if not na(del.dow_label)
                label.delete(del.dow_label)
            if not na(del.open_line)
                line.delete(del.open_line)
            if not na(del.open_label)
                label.delete(del.open_label)

    // ---- update current (live) HTF candle ----
    if candles.size() > 0
        Candle cur = candles.first()
        cur.h_idx := high > cur.h ? bar_index : cur.h_idx
        cur.h     := high > cur.h ? high     : cur.h
        cur.l_idx := low  < cur.l ? bar_index : cur.l_idx
        cur.l     := low  < cur.l ? low      : cur.l
        cur.c     := close
        cur.c_idx := bar_index

        bool bull = cur.c > cur.o
        box.set_top         (cur.body, cur.o)
        box.set_bottom      (cur.body, cur.c)
        box.set_bgcolor     (cur.body, bull ? in_bull_body   : in_bear_body)
        box.set_border_color(cur.body, bull ? in_bull_border : in_bear_border)
        line.set_color(cur.wick_up,   bull ? in_bull_wick : in_bear_wick)
        line.set_color(cur.wick_down, bull ? in_bull_wick : in_bear_wick)
        line.set_y1(cur.wick_up,   cur.h)
        line.set_y2(cur.wick_up,   math.max(cur.o, cur.c))
        line.set_y1(cur.wick_down, cur.l)
        line.set_y2(cur.wick_down, math.min(cur.o, cur.c))

    // ---- HTF opening line(s) on the LTF chart ----
    // Drawn at the *price level* of the LTF chart, anchored at the bar where
    // each HTF candle opened.
    if in_ol_show and candles.size() > 0 and (barstate.isrealtime or barstate.islast)
        for i = 0 to candles.size() - 1
            Candle c = candles.get(i)
            bool isCurrent = (i == 0)

            // skip historical opens unless user asked for them
            if not isCurrent and not in_ol_history
                if not na(c.open_line)
                    line.delete(c.open_line)
                    c.open_line := na
                if not na(c.open_label)
                    label.delete(c.open_label)
                    c.open_label := na
            else
                int x1 = c.o_idx
                int x2 = isCurrent ? bar_index : (i > 0 ? candles.get(i - 1).o_idx - 1 : bar_index)
                if na(c.open_line)
                    c.open_line := line.new(x1, c.o, x2, c.o, xloc = xloc.bar_index, color = in_ol_color, style = f_lineStyle(in_ol_style), width = in_ol_width, extend = isCurrent ? extend.right : extend.none)
                else
                    line.set_xy1(c.open_line, x1, c.o)
                    line.set_xy2(c.open_line, x2, c.o)
                    line.set_color(c.open_line, in_ol_color)
                    line.set_style(c.open_line, f_lineStyle(in_ol_style))
                    line.set_width(c.open_line, in_ol_width)
                    line.set_extend(c.open_line, isCurrent ? extend.right : extend.none)

                if in_ol_label
                    string txt = str.tostring(c.o)
                    if na(c.open_label)
                        c.open_label := label.new(x2, c.o, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color_transparent, textcolor = in_ol_color, size = size.small)
                    else
                        label.set_xy(c.open_label, x2, c.o)
                        label.set_text(c.open_label, txt)
                else if not na(c.open_label)
                    label.delete(c.open_label)
                    c.open_label := na

    // ---- inline HTF candle rendering (right of price) ----
    if (barstate.isrealtime or barstate.islast) and candles.size() > 0
        int sz = candles.size()
        for i = sz - 1 to 0
            Candle c = candles.get(i)
            int t_buf = in_offset + (in_width + in_buffer) * (sz - i - 1)
            box.set_left  (c.body, bar_index + t_buf)
            box.set_right (c.body, bar_index + in_width + t_buf)
            line.set_x1(c.wick_up,   bar_index + in_width / 2 + t_buf)
            line.set_x2(c.wick_up,   bar_index + in_width / 2 + t_buf)
            line.set_x1(c.wick_down, bar_index + in_width / 2 + t_buf)
            line.set_x2(c.wick_down, bar_index + in_width / 2 + t_buf)
            if in_dow_show
                if not na(c.dow_label)
                    c.dow_label.set_y(c.h)
                    c.dow_label.set_x(bar_index + in_width / 2 + t_buf)
                    c.dow_label.set_text(c.dow)
                else
                    c.dow_label := label.new(bar_index + in_width / 2 + t_buf, c.h, c.dow, color = color_transparent, textcolor = in_dow_color, style = label.style_label_down, size = in_dow_size)

        // labels
        float top    = f_setHigh(candles)
        float bottom = f_setLow(candles, top)
        int   left   = bar_index + in_offset + (in_width + in_buffer) * (sz - 1) / 2

        if in_lbl_show
            string lblt = f_htfName(htf)
            if in_tmr_show
                lblt := lblt + ' (' + f_remaining(htf) + ')'

            if in_lbl_pos == 'Both' or in_lbl_pos == 'Top'
                if not na(tfNameTop)
                    tfNameTop.set_xy(left, top)
                    tfNameTop.set_text(lblt)
                else
                    tfNameTop := label.new(left, top, lblt, color = color_transparent, textcolor = in_lbl_color, style = label.style_label_down, size = in_lbl_size)
            if in_lbl_pos == 'Both' or in_lbl_pos == 'Bottom'
                if not na(tfNameBottom)
                    tfNameBottom.set_xy(left, bottom)
                    tfNameBottom.set_text(lblt)
                else
                    tfNameBottom := label.new(left, bottom, lblt, color = color_transparent, textcolor = in_lbl_color, style = label.style_label_up, size = in_lbl_size)

        // imbalances (FVG + VI) — recomputed each tick like original
        if imbalances.size() > 0
            for i = imbalances.size() - 1 to 0
                Imbalance del = imbalances.get(i)
                box.delete(del.b)
                imbalances.pop()

        if candles.size() > 3 and in_fvg_show
            for i = 0 to candles.size() - 3
                Candle c1 = candles.get(i)
                Candle c2 = candles.get(i + 2)
                Candle c3 = candles.get(i + 1)
                if c1.l > c2.h and math.min(c1.o, c1.c) > math.max(c2.o, c2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(c2.body), c2.h, box.get_right(c1.body), c1.l, bgcolor = in_fvg_color, border_color = color_transparent, xloc = xloc.bar_index)
                    imbalances.push(imb)
                if c1.h < c2.l and math.max(c1.o, c1.c) < math.min(c2.o, c2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(c1.body), c1.h, box.get_left(c2.body), c2.l, bgcolor = in_fvg_color, border_color = color_transparent)
                    imbalances.push(imb)
                box temp = box.copy(c3.body)
                box.delete(c3.body)
                c3.body := temp

        if candles.size() > 2 and in_vi_show
            for i = 0 to candles.size() - 2
                Candle c1 = candles.get(i)
                Candle c2 = candles.get(i + 1)
                if c1.l < c2.h and math.min(c1.o, c1.c) > math.max(c2.o, c2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_left(c2.body), math.min(c1.o, c1.c), box.get_right(c1.body), math.max(c2.o, c2.c), bgcolor = in_vi_color, border_color = color_transparent)
                    imbalances.push(imb)
                if c1.h > c2.l and math.max(c1.o, c1.c) < math.min(c2.o, c2.c)
                    Imbalance imb = Imbalance.new()
                    imb.b := box.new(box.get_right(c1.body), math.min(c2.o, c2.c), box.get_left(c2.body), math.max(c1.o, c1.c), bgcolor = in_vi_color, border_color = color_transparent)
                    imbalances.push(imb)

        // trace lines (kept from original)
        if in_tr_show and candles.size() > 0
            Candle cur = candles.first()
            if bar_index - cur.o_idx < 5000
                if na(trace.o)
                    trace.o := line.new(cur.o_idx, cur.o, box.get_left(cur.body), cur.o, xloc = xloc.bar_index, color = in_tr_o_color, style = f_lineStyle(in_tr_o_style), width = in_tr_o_size)
                else
                    line.set_xy1(trace.o, cur.o_idx, cur.o)
                    line.set_xy2(trace.o, box.get_left(cur.body), cur.o)
                if in_pl_show
                    if na(trace.o_l)
