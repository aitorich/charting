// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// © SMT Quarter Sequences Indicator
// Compares NQ/YM (or any correlated pair) within 4HR candle quarters (1H candles)

//@version=5
indicator("SMT Quarter Sequences (4HR)", overlay=true, max_labels_count=500, max_boxes_count=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
string symA_input   = input.symbol("NQ1!", "Symbol A (Primary)", group="Symbols")
string symB_input   = input.symbol("YM1!", "Symbol B (Correlated)", group="Symbols")

color bullColor     = input.color(color.new(color.green, 20), "Bullish SMT Color", group="Display")
color bearColor     = input.color(color.new(color.red, 20), "Bearish SMT Color", group="Display")
bool showLabels     = input.bool(true, "Show Quarter Labels", group="Display")
bool showBoxes      = input.bool(true, "Show 4HR Candle Boxes", group="Display")
bool showTable      = input.bool(true, "Show Summary Table", group="Display")

// ─── TIMEFRAME VALIDATION ─────────────────────────────────────────────────────
// This indicator must run on 1H chart to divide 4HR into quarters
isSupportedTF = timeframe.period == "60"

if not isSupportedTF
    runtime.error("This indicator must be applied to a 1-Hour chart.")

// ─── DATA REQUESTS ────────────────────────────────────────────────────────────
// Request 1H data for both symbols
[symA_open, symA_high, symA_low, symA_close] = request.security(symA_input, "60", [open, high, low, close])
[symB_open, symB_high, symB_low, symB_close] = request.security(symB_input, "60", [open, high, low, close])

// Request 4H data to identify HTF candle boundaries
[htf_open, htf_high, htf_low, htf_close] = request.security(symA_input, "240", [open, high, low, close])
bool isNew4H = request.security(symA_input, "240", timeframe.change("240"))

// ─── QUARTER TRACKING ─────────────────────────────────────────────────────────
var int quarterCount = 0  // 0-3 representing Q1-Q4
var float[] symA_highs = array.new_float(4, na)
var float[] symA_lows  = array.new_float(4, na)
var float[] symB_highs = array.new_float(4, na)
var float[] symB_lows  = array.new_float(4, na)

// Reset on new 4HR candle
if isNew4H
    quarterCount := 0
    array.fill(symA_highs, na)
    array.fill(symA_lows, na)
    array.fill(symB_highs, na)
    array.fill(symB_lows, na)

// Store quarter data
if quarterCount < 4
    array.set(symA_highs, quarterCount, symA_high)
    array.set(symA_lows, quarterCount, symA_low)
    array.set(symB_highs, quarterCount, symB_high)
    array.set(symB_lows, quarterCount, symB_low)

// ─── SMT DETECTION LOGIC ──────────────────────────────────────────────────────
// SMT Divergence: One makes new high/low, the other fails to confirm

// Compare current quarter to previous quarter within same 4HR candle
bool bullishSMT = false  // A makes lower low, B does NOT (or vice versa) = bullish
bool bearishSMT = false  // A makes higher high, B does NOT (or vice versa) = bearish

if quarterCount > 0 and quarterCount < 4
    float prevA_high = array.get(symA_highs, quarterCount - 1)
    float prevA_low  = array.get(symA_lows, quarterCount - 1)
    float prevB_high = array.get(symB_highs, quarterCount - 1)
    float prevB_low  = array.get(symB_lows, quarterCount - 1)
    
    float currA_high = symA_high
    float currA_low  = symA_low
    float currB_high = symB_high
    float currB_low  = symB_low
    
    // Bearish SMT: A makes higher high, B fails (or B makes HH, A fails)
    bool a_HH = currA_high > prevA_high
    bool b_HH = currB_high > prevB_high
    bearishSMT := (a_HH and not b_HH) or (b_HH and not a_HH)
    
    // Bullish SMT: A makes lower low, B fails (or B makes LL, A fails)
    bool a_LL = currA_low < prevA_low
    bool b_LL = currB_low < prevB_low
    bullishSMT := (a_LL and not b_LL) or (b_LL and not a_LL)

// ─── PLOTTING & LABELS ───────────────────────────────────────────────────────
// Quarter label text
string qLabel = quarterCount == 0 ? "Q1" : quarterCount == 1 ? "Q2" : quarterCount == 2 ? "Q3" : "Q4"

// Background color for SMT divergence quarters
bgcolor(bullishSMT ? color.new(bullColor, 85) : na, title="Bullish SMT BG")
bgcolor(bearishSMT ? color.new(bearColor, 85) : na, title="Bearish SMT BG")

// Labels
if showLabels and bullishSMT
    label.new(bar_index, low, qLabel + "\n🟢 Bull SMT", 
         style=label.style_label_up, color=bullColor, textcolor=color.white, size=size.small)

if showLabels and bearishSMT
    label.new(bar_index, high, qLabel + "\n🔴 Bear SMT", 
         style=label.style_label_down, color=bearColor, textcolor=color.white, size=size.small)

// ─── 4HR BOUNDARY VERTICAL LINES ─────────────────────────────────────────────
if isNew4H and showBoxes
    line.new(bar_index, high, bar_index, low, extend=extend.both, 
         color=color.new(color.gray, 60), style=line.style_dashed, width=1)

// ─── QUARTER COUNTER INCREMENT ────────────────────────────────────────────────
if not isNew4H
    quarterCount += 1
else
    quarterCount := 1  // First bar after reset is Q1, move to next

// ─── SUMMARY TABLE ────────────────────────────────────────────────────────────
var table summaryTable = table.new(position.top_right, 3, 6, bgcolor=color.new(color.black, 80), 
     border_width=1, border_color=color.gray)

// Count SMT occurrences per quarter
var int bullQ1 = 0, var int bullQ2 = 0, var int bullQ3 = 0, var int bullQ4 = 0
var int bearQ1 = 0, var int bearQ2 = 0, var int bearQ3 = 0, var int bearQ4 = 0

if bullishSMT
    if quarterCount == 1
        bullQ1 += 1
    else if quarterCount == 2
        bullQ2 += 1
    else if quarterCount == 3
        bullQ3 += 1
    else
        bullQ4 += 1

if bearishSMT
    if quarterCount == 1
        bearQ1 += 1
    else if quarterCount == 2
        bearQ2 += 1
    else if quarterCount == 3
        bearQ3 += 1
    else
        bearQ4 += 1

if showTable and barstate.islast
    table.cell(summaryTable, 0, 0, "Quarter", text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 1, 0, "Bull SMT", text_color=bullColor, text_size=size.small)
    table.cell(summaryTable, 2, 0, "Bear SMT", text_color=bearColor, text_size=size.small)
    
    table.cell(summaryTable, 0, 1, "Q1", text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 1, 1, str.tostring(bullQ1), text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 2, 1, str.tostring(bearQ1), text_color=color.white, text_size=size.small)
    
    table.cell(summaryTable, 0, 2, "Q2", text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 1, 2, str.tostring(bullQ2), text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 2, 2, str.tostring(bearQ2), text_color=color.white, text_size=size.small)
    
    table.cell(summaryTable, 0, 3, "Q3", text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 1, 3, str.tostring(bullQ3), text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 2, 3, str.tostring(bearQ3), text_color=color.white, text_size=size.small)
    
    table.cell(summaryTable, 0, 4, "Q4", text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 1, 4, str.tostring(bullQ4), text_color=color.white, text_size=size.small)
    table.cell(summaryTable, 2, 4, str.tostring(bearQ4), text_color=color.white, text_size=size.small)
    
    int totalBull = bullQ1 + bullQ2 + bullQ3 + bullQ4
    int totalBear = bearQ1 + bearQ2 + bearQ3 + bearQ4
    table.cell(summaryTable, 0, 5, "TOTAL", text_color=color.yellow, text_size=size.small)
    table.cell(summaryTable, 1, 5, str.tostring(totalBull), text_color=color.yellow, text_size=size.small)
    table.cell(summaryTable, 2, 5, str.tostring(totalBear), text_color=color.yellow, text_size=size.small)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(bullishSMT, title="Bullish SMT Divergence", message="Bullish SMT detected in {{ticker}} at " + qLabel)
alertcondition(bearishSMT, title="Bearish SMT Divergence", message="Bearish SMT detected in {{ticker}} at " + qLabel)
