// SMT Swing — C2 / C3 Hunter
//
// Pair-symmetric SMT detector for swing-pivot liquidity (NQ vs YM by default).
// On each chart, fires only when THIS chart's symbol is the sweeping side, so every
// SMT line anchors at the pivot price and extends to a wick BEYOND the level.
//
// Two triggers per pivot:
//   1. C2 SMT     — single-bar: the bar that sweeps the pivot + (optional) closes
//                   back inside, while the OTHER pair member's same bar does NOT
//                   wick beyond its own pivot. Most SMTs occur here.
//   2. 2-bar SMT  — the C3 bar (immediately after C2) extends the move deeper on
//                   THIS chart while the OTHER pair member's combined C2+C3 window
//                   stays inside its own pivot. Fires on C3.
//
// PAIR-SYMMETRIC: add to BOTH NQ and YM charts. Auto-detects which side via
// syminfo.ticker and requests the OTHER symbol via security().

//@version=6
indicator("SMT Swing — C2 / C3 Hunter", "SMT Swing", overlay=true,
     max_lines_count=500, max_labels_count=100)

// ─── INPUTS ──────────────────────────────────────────────────────────
gS  = "Symbols"
gT  = "Triggers"
gV  = "Validation"
gD  = "Display"
gSt = "Style"

string symA = input.symbol("NQ1!", "Pair Symbol A", group=gS)
string symB = input.symbol("YM1!", "Pair Symbol B", group=gS)

// Auto-detect: if chart's ticker matches symA, the OTHER side is symB. Otherwise
// chart is on the B-side and we request symA. Same script paints both charts.
string otherSym = str.contains(symA, syminfo.ticker) ? symB : symA

bool   showC2     = input.bool(true, "Show C2 SMT (single-bar)",   group=gT)
bool   show2Bar   = input.bool(true, "Show 2-bar SMT (C2 + C3)",   group=gT)
int    swingL     = input.int(2, "Swing Pivot Left",  minval=1, maxval=20, group=gT)
int    swingR     = input.int(2, "Swing Pivot Right", minval=1, maxval=20, group=gT)

bool   requireCloseBack = input.bool(false, "Require close back inside level (strict C2)", group=gV)

int    displayBars = input.int(2000, "Show Last N Bars", minval=50, group=gD)

color  bullClr     = input.color(color.new(#00e676, 0),  "Bull SMT Color",   group=gSt)
color  bearClr     = input.color(color.new(#ff1744, 0),  "Bear SMT Color",   group=gSt)
color  levelClr    = input.color(color.new(#ffb74d, 30), "Pivot Line Color", group=gSt)
int    c2Width     = input.int(2, "C2 SMT Width",    minval=1, maxval=5, group=gSt)
int    twoBarWidth = input.int(2, "2-bar SMT Width", minval=1, maxval=5, group=gSt)
bool   showLines   = input.bool(true, "Show pivot lines", group=gSt)

// ─── DATA (the OTHER pair member) ────────────────────────────────────
[bH, bL, bO, bC] = request.security(otherSym, timeframe.period, [high, low, open, close], lookahead=barmerge.lookahead_off)

// ─── DISPLAY FILTER (bar-based, works on any TF from 5m to 1W) ──────
bool inDisplay = bar_index >= last_bar_index - displayBars

// ════════════════════════════════════════════════════════════════════
// PIVOT DETECTION (chart + other)
// ════════════════════════════════════════════════════════════════════
float aSwHi_raw = ta.pivothigh(high, swingL, swingR)
float aSwLo_raw = ta.pivotlow(low,  swingL, swingR)
[bSwHi_raw, bSwLo_raw] = request.security(otherSym, timeframe.period,
     [ta.pivothigh(high, swingL, swingR), ta.pivotlow(low, swingL, swingR)],
     lookahead=barmerge.lookahead_off)

// ─── SWING LOW STATE (bull SMT) ──────────────────────────────────────
var float aSwL = na
var int   aSwLBar = na
var int   aSwL_phase = 0           // 0=waiting C2, 1=waiting C3, 2=done
var float aSwL_C2_aLow = na
var float aSwL_C2_bLow = na
var line  swLLineV = na

// ─── SWING HIGH STATE (bear SMT) ─────────────────────────────────────
var float aSwH = na
var int   aSwHBar = na
var int   aSwH_phase = 0
var float aSwH_C2_aHigh = na
var float aSwH_C2_bHigh = na
var line  swHLineV = na

// ─── OTHER pair member's most-recent confirmed pivots ────────────────
var float bSwH = na
var float bSwL = na

// new pivot on chart → reset state for that side
if not na(aSwLo_raw)
    line.delete(swLLineV)
    aSwL := aSwLo_raw
    aSwLBar := bar_index - swingR
    aSwL_phase := 0
    aSwL_C2_aLow := na
    aSwL_C2_bLow := na
    if showLines
        swLLineV := line.new(aSwLBar, aSwL, bar_index, aSwL, color=levelClr, style=line.style_dashed, width=1)

if not na(aSwHi_raw)
    line.delete(swHLineV)
    aSwH := aSwHi_raw
    aSwHBar := bar_index - swingR
    aSwH_phase := 0
    aSwH_C2_aHigh := na
    aSwH_C2_bHigh := na
    if showLines
        swHLineV := line.new(aSwHBar, aSwH, bar_index, aSwH, color=levelClr, style=line.style_dashed, width=1)

if not na(bSwHi_raw)
    bSwH := bSwHi_raw
if not na(bSwLo_raw)
    bSwL := bSwLo_raw

if not na(swLLineV) and aSwL_phase != 2
    line.set_x2(swLLineV, bar_index)
if not na(swHLineV) and aSwH_phase != 2
    line.set_x2(swHLineV, bar_index)

// ════════════════════════════════════════════════════════════════════
// SWING LOW — bull SMT (C2 + 2-bar)
// ════════════════════════════════════════════════════════════════════
bool c2BullFire     = false
bool twoBarBullFire = false

if aSwL_phase == 0 and not na(aSwL) and not na(bSwL) and inDisplay
    bool aWicked     = low < aSwL
    bool aClosedBack = close > aSwL
    bool aValidC2    = aWicked and (not requireCloseBack or aClosedBack)
    bool bWicked     = bL < bSwL
    if aValidC2
        aSwL_C2_aLow := low
        aSwL_C2_bLow := bL
        if showC2 and not bWicked
            line.new(aSwLBar, aSwL, bar_index, low, color=bullClr, width=c2Width, style=line.style_solid)
            c2BullFire := true
        aSwL_phase := 1
    else if aWicked and not aClosedBack
        // chart broke clean through → pivot consumed, no C2 on this side
        aSwL_phase := 2
else if aSwL_phase == 1 and not na(aSwL) and not na(bSwL) and inDisplay
    bool aDeepened     = low < aSwL_C2_aLow
    float bCombinedLow = math.min(aSwL_C2_bLow, bL)
    bool bStayedInside = bCombinedLow >= bSwL
    if show2Bar and aDeepened and bStayedInside
        line.new(aSwLBar, aSwL, bar_index, low, color=bullClr, width=twoBarWidth, style=line.style_solid)
        twoBarBullFire := true
    aSwL_phase := 2

// ════════════════════════════════════════════════════════════════════
// SWING HIGH — bear SMT (C2 + 2-bar)
// ════════════════════════════════════════════════════════════════════
bool c2BearFire     = false
bool twoBarBearFire = false

if aSwH_phase == 0 and not na(aSwH) and not na(bSwH) and inDisplay
    bool aWicked     = high > aSwH
    bool aClosedBack = close < aSwH
    bool aValidC2    = aWicked and (not requireCloseBack or aClosedBack)
    bool bWicked     = bH > bSwH
    if aValidC2
        aSwH_C2_aHigh := high
        aSwH_C2_bHigh := bH
        if showC2 and not bWicked
            line.new(aSwHBar, aSwH, bar_index, high, color=bearClr, width=c2Width, style=line.style_solid)
            c2BearFire := true
        aSwH_phase := 1
    else if aWicked and not aClosedBack
        aSwH_phase := 2
else if aSwH_phase == 1 and not na(aSwH) and not na(bSwH) and inDisplay
    bool aDeepened      = high > aSwH_C2_aHigh
    float bCombinedHigh = math.max(aSwH_C2_bHigh, bH)
    bool bStayedInside  = bCombinedHigh <= bSwH
    if show2Bar and aDeepened and bStayedInside
        line.new(aSwHBar, aSwH, bar_index, high, color=bearClr, width=twoBarWidth, style=line.style_solid)
        twoBarBearFire := true
    aSwH_phase := 2

// ════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════
alertcondition(c2BullFire,     title="C2 Bull SMT @ Swing Low",     message="C2 Bull SMT @ Swing Low on {{ticker}}")
alertcondition(c2BearFire,     title="C2 Bear SMT @ Swing High",    message="C2 Bear SMT @ Swing High on {{ticker}}")
alertcondition(twoBarBullFire, title="2-bar Bull SMT @ Swing Low",  message="2-bar Bull SMT @ Swing Low on {{ticker}}")
alertcondition(twoBarBearFire, title="2-bar Bear SMT @ Swing High", message="2-bar Bear SMT @ Swing High on {{ticker}}")
